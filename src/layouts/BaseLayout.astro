---
import '@/styles/global.css';
// Self-hosted Inter (замена Google Fonts). Каждый {weight}.css включает все
// подмножества, в т.ч. latin + cyrillic + cyrillic-ext (unicode-range), font-display: swap.
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/inter/800.css';
import '@fontsource/inter/900.css';
import '@/styles/onest.css';
import { organizationSchema, websiteSchema } from '@/lib/jsonld';
import BannerHostIsland from '@/components/islands/BannerHostIsland.jsx';
import CookieBanner from '@/components/v2/CookieBanner.astro';

interface Props {
  title: string;
  description: string;
  canonical: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  twitterImage?: string;
  ogType?: string;
  noindex?: boolean;
  robots?: string;
  jsonLd?: object[];
}

const {
  title,
  description,
  canonical,
  ogTitle,
  ogDescription,
  ogImage = '/og/og-main.png',
  twitterImage,
  ogType = 'website',
  noindex = false,
  robots,
  jsonLd = [],
} = Astro.props;

const SITE = import.meta.env.PUBLIC_SITE_URL || 'https://shvec.tech';
const ogImageFull = ogImage.startsWith('http') ? ogImage : `${SITE}${ogImage}`;
const twitterImageRaw = twitterImage || ogImage;
const twitterImageFull = twitterImageRaw.startsWith('http')
  ? twitterImageRaw
  : `${SITE}${twitterImageRaw}`;
const allSchemas = [organizationSchema, websiteSchema, ...jsonLd];
const isProd = import.meta.env.PUBLIC_ENV === 'production';

// Robots: dev-окружение всегда noindex (чтобы не дублировать prod),
// иначе noindex prop > robots prop > index follow default
let robotsContent;
if (!isProd) robotsContent = 'noindex, nofollow';
else if (noindex) robotsContent = 'noindex, nofollow';
else if (robots) robotsContent = robots;
else robotsContent = 'index, follow';

const ogTitleFinal = ogTitle || title;
const ogDescriptionFinal = ogDescription || description;

const apiUrl = import.meta.env.PUBLIC_API_URL;
const yandexVerification = import.meta.env.PUBLIC_YANDEX_VERIFICATION;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robotsContent} />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={ogTitleFinal} />
    <meta property="og:description" content={ogDescriptionFinal} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageFull} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogTitleFinal} />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content="Швец" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitleFinal} />
    <meta name="twitter:description" content={ogDescriptionFinal} />
    <meta name="twitter:image" content={twitterImageFull} />
    <meta name="twitter:image:alt" content={ogTitleFinal} />

    {yandexVerification && <meta name="yandex-verification" content={yandexVerification} />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="alternate icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    {allSchemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    {apiUrl && <link rel="preconnect" href={apiUrl} crossorigin />}
  </head>

  <body class="font-inter overflow-x-hidden">
    <slot />

    <!-- Хост баннеров по действиям визитора (слушает 'shvec:show-banner') -->
    <BannerHostIsland client:load />

    <!-- Cookie-consent: аналитика запускается только после явного согласия -->
    <CookieBanner />

    <script>
      import { initTracker, trackClick } from '@/lib/tracker';
      import { reachYandexGoal } from '@/lib/yandexMetrika';
      import { initBanners } from '@/lib/banners';
      const hasAnalyticsConsent = () => {
        try {
          return window.localStorage.getItem('shvec_cookie_consent') === 'accepted';
        } catch {
          return false;
        }
      };
      const startAnalytics = () => {
        if (!hasAnalyticsConsent()) return;
        initTracker()
          .then((ids) => initBanners(ids))
          .catch(() => {});
      };
      startAnalytics();
      window.addEventListener('shvec:analytics-consent', startAnalytics);
      document.addEventListener('click', (e) => {
        const target = e.target as Element | null;
        if (!target) return;

        const openBtn = target.closest('.js-open-contact') as HTMLElement | null;
        if (openBtn) {
          const source = openBtn.dataset.source || 'modal';
          window.dispatchEvent(new CustomEvent('shvec:open-contact', { detail: { source } }));
        }

        const el = target.closest('[data-track]') as HTMLElement | null;
        if (!el) return;
        const id = el.dataset.track || '';
        const block = el.dataset.trackBlock || '';
        const text = el.dataset.trackText || el.textContent?.trim() || '';
        if (hasAnalyticsConsent()) {
          trackClick(text, id, block, { bannerId: el.dataset.bannerId || '' });
        }

        const yandexGoals = (el.dataset.ymGoals || el.dataset.ymGoal || '')
          .split(/\s+/)
          .filter(Boolean);
        [...new Set(yandexGoals)].forEach((goal) => reachYandexGoal(goal));
      });
    </script>
  </body>
</html>
