---
// Блок 8 · FAQ — 10 вопросов. Нативный <details>, без JS.
// Данные — в src/data/faq.js (общий источник для блока и FAQPage-схемы).
import { FAQ } from '@/data/faq';
---
<section id="faq" class="bg-light section faq-sect">
  <div class="container">
    <div class="faq-layout">
      <div class="faq-aside">
        <div class="eyebrow">
          <div class="eyebrow-line"></div>
          <span class="eyebrow-text">FAQ</span>
        </div>
        <div class="faq-head">
          <h2 class="faq-h2">Частые <em>вопросы</em></h2>
        </div>
      </div>

      <div class="faq-list">
      {FAQ.map((item, i) => (
        <details class="faq-item" name="faq">
          <summary class="faq-q" data-track={`faq_open_${i + 1}`} data-track-block="faq">
            <span class="faq-q-num">{String(i + 1).padStart(2, '0')}</span>
            <span class="faq-q-text">{item.q}</span>
            <svg class="faq-chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="6 9 12 15 18 9" />
            </svg>
          </summary>
          <div class="faq-a">
            {item.a.map((p) => <p class="faq-a-p">{p}</p>)}
          </div>
        </details>
      ))}
      </div>
    </div>
  </div>
</section>

<style>
  .faq-sect { background: #EDEEF2; }
  .faq-layout {
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: 56px;
    align-items: start;
  }
  .faq-aside { position: sticky; top: 96px; }
  .faq-head { margin-bottom: 0; }
  .faq-h2 {
    font-size: 38px;
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--l-text);
  }
  .faq-h2 em { font-style: normal; color: var(--brand); }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .faq-item {
    background: var(--l-surface);
    clip-path: polygon(0 0,100% 0,100% calc(100% - 10px),calc(100% - 10px) 100%,0 100%);
    transition: background 0.16s;
  }
  .faq-item[open] { background: #F4F7FF; }

  .faq-q {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 22px 26px;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }
  .faq-q::-webkit-details-marker { display: none; }
  .faq-q-num {
    font-size: 13px;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    color: var(--brand);
    flex-shrink: 0;
    letter-spacing: 0.03em;
  }
  .faq-q-text {
    font-size: 16px;
    font-weight: 600;
    line-height: 1.4;
    color: var(--l-text);
    flex-grow: 1;
  }
  .faq-chev {
    flex-shrink: 0;
    color: var(--l-text-mut);
    transition: transform 0.2s ease, color 0.16s;
  }
  .faq-item[open] .faq-chev { transform: rotate(180deg); color: var(--brand); }

  .faq-a {
    padding: 0 26px 24px 58px;
  }
  .faq-a-p {
    font-size: 14px;
    line-height: 1.7;
    color: var(--l-text-sec);
  }
  .faq-a-p + .faq-a-p { margin-top: 12px; }

  @media (max-width: 768px) {
    .faq-layout { grid-template-columns: 1fr; gap: 24px; }
    .faq-aside { position: static; }
    .faq-h2 { font-size: 28px; }
    .faq-q { padding: 18px 18px; gap: 12px; }
    .faq-q-text { font-size: 14px; }
    .faq-a { padding: 0 18px 20px 18px; }
  }
</style>
