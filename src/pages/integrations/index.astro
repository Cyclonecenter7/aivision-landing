---
import SeoContentLayout from '@/layouts/SeoContentLayout.astro';
import { integrations } from '@/data/seo-content';

const sections = [
  {
    title: 'Не ещё одна система, а связь между существующими',
    text: ['Швец подключается к рабочим источникам данных и собирает из них управленческую картину. Сотрудникам не нужно переносить каждую операцию в отдельную таблицу собственника.'],
  },
  {
    title: 'Типовые контуры',
    links: integrations.map((item) => ({ label: item.heading, href: `/integrations/${item.slug}/` })),
  },
  {
    title: 'Что определяем до разработки',
    bullets: ['источник правды для каждого показателя;', 'направление и частоту обмена;', 'правила обработки дублей и ошибок;', 'ответственных за сверку после запуска.'],
  },
];
---

<SeoContentLayout
  title="Интеграции CRM, 1С, банков и сайта | Швец"
  description="Связываем CRM, 1С, банки, сайт и управленческую отчётность в единый контур без ручного дублирования данных."
  canonical="https://shvec.tech/integrations/"
  eyebrow="Интеграции"
  heading="Связываем рабочие системы в единую управленческую картину"
  lead="CRM, 1С, банки, сайт и задачи остаются источниками данных, а собственник получает согласованные показатели и отклонения в одном месте."
  {sections}
/>
