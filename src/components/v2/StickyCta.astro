---
---
<div class="sticky-cta" id="sticky-cta">
  <button
    type="button"
    class="sticky-cta-btn js-open-contact"
    data-source="sticky"
    data-track="sticky_cta"
    data-track-block="sticky"
    data-ym-goal="Begin_footer_click"
  >
    Получить аудит
  </button>
  <a
    href="/demo/"
    target="_blank"
    rel="noopener"
    class="sticky-cta-demo"
    data-track="sticky_demo"
    data-track-block="sticky"
  >
    <span class="sticky-cta-demo-inner">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polygon points="5 3 19 12 5 21 5 3" />
      </svg>
      Посмотреть демо
    </span>
  </a>
</div>

<script>
  const el = document.getElementById('sticky-cta');
  if (el) {
    const update = () => {
      const hero = document.querySelector('.hero');
      if (!hero) return;
      const heroBottom = hero.getBoundingClientRect().bottom;
      el.classList.toggle('visible', heroBottom < 100);
    };
    update();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
  }
</script>
