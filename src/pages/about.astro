---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Footer from '@/components/v2/Footer.astro';
import { SEO, seoUrl } from '@/lib/seo';

const seo = SEO.about;

const METHOD = [
  ['01', 'Диагностика', 'Формулируем вопросы собственника, описываем процессы и определяем первый управленческий контур.'],
  ['02', 'Карта данных', 'Проверяем CRM, финансы, задачи и отчётность. Для каждого показателя фиксируем источник и правило расчёта.'],
  ['03', 'Первый запуск', 'Подключаем согласованные источники, роли и дашборд. Проверяем данные вместе с ответственными сотрудниками.'],
  ['04', 'Стабилизация', 'Смотрим, как команда пользуется системой, устраняем расхождения и закрепляем правила работы.'],
];

const SECURITY = [
  ['Хранение', 'Рабочая инфраструктура Швец размещена на сервере в России. Базы данных не опубликованы в открытый интернет.'],
  ['Доступ', 'Права разделяются по ролям и рабочим областям. Доступ получают только согласованные участники проекта.'],
  ['Защита', 'Передача данных идёт по TLS. Пароли хранятся как необратимые хеши, вход в административные контуры защищён вторым фактором.'],
  ['Резервирование', 'До запуска фиксируем в договоре состав данных, периодичность резервного копирования и порядок восстановления.'],
  ['Завершение работы', 'При завершении сотрудничества согласовываем формат и срок выгрузки данных, после чего прекращаем доступ и сопровождение.'],
  ['Персональные данные', 'Обрабатываем персональные данные в рамках 152-ФЗ и публичной политики. Не используем данные клиента для посторонних задач.'],
];

const RESULT = [
  'согласованные источники данных подключены или настроен регламент их загрузки;',
  'показатели первого контура рассчитаны по зафиксированным правилам;',
  'дашборд собственника показывает актуальные финансы, продажи и ключевые отклонения;',
  'роли и права доступа проверены на реальных пользователях;',
  'ответственные сотрудники знают, какие данные и когда они обновляют;',
  'критичные расхождения и следующие этапы зафиксированы в плане развития.',
];
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  canonical={seoUrl(seo)}
  ogTitle={seo.ogTitle}
  ogDescription={seo.ogDescription}
  ogImage={seo.ogImage}
  twitterImage={seo.twitterImage}
  robots={seo.robots}
>
  <main class="about-page">
    <header class="about-hero">
      <div class="about-wrap">
        <a class="about-back" href="/">← На главную</a>
        <p class="about-eyebrow">О компании</p>
        <h1>Швец соединяет данные, процессы и решения в одну систему управления</h1>
        <p class="about-lead">
          Когда компания растёт, данные оказываются разбросаны между CRM, таблицами,
          переписками и сотрудниками. Собственнику всё сложнее увидеть бизнес целиком
          и принимать решения на основе актуальной картины. Так появился Швец.
        </p>
      </div>
    </header>

    <section class="about-section">
      <div class="about-wrap about-story">
        <div>
          <p class="about-eyebrow">Люди</p>
          <h2>Кто отвечает за результат</h2>
        </div>
        <div class="about-copy">
          <h3>Юлия Будаева</h3>
          <p class="about-role">Основатель Швец и сторона договора</p>
          <p>
            За каждый проект отвечает команда из специалистов по бизнес-процессам,
            управленческим финансам, продукту и техническому внедрению. Состав команды
            и зоны ответственности фиксируем до старта проекта.
          </p>
          <p>
            Мы не приносим коробочное решение и не оставляем клиента один на один
            с платформой. После запуска продолжаем развивать систему вместе с командой
            клиента и адаптируем её под изменения в бизнесе.
          </p>
        </div>
      </div>
    </section>

    <section class="about-section about-section--muted">
      <div class="about-wrap">
        <p class="about-eyebrow">Методология</p>
        <h2>Сначала управленческий вопрос, затем данные</h2>
        <p class="about-intro">
          Мы не подключаем источники ради количества интеграций. Каждый показатель
          должен помогать собственнику принять конкретное решение.
        </p>
        <div class="about-grid">
          {METHOD.map(([num, title, text]) => (
            <article class="about-card">
              <span>{num}</span>
              <h3>{title}</h3>
              <p>{text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="about-section about-section--dark">
      <div class="about-wrap">
        <p class="about-eyebrow">Безопасность данных</p>
        <h2>Доступ, хранение и выход из проекта понятны до старта</h2>
        <div class="about-grid about-grid--three">
          {SECURITY.map(([title, text]) => (
            <article class="about-card">
              <h3>{title}</h3>
              <p>{text}</p>
            </article>
          ))}
        </div>
        <p class="about-note">
          Точные требования к резервированию, срокам хранения, интеграциям и формату
          выгрузки зависят от проекта и фиксируются в договоре.
        </p>
      </div>
    </section>

    <section class="about-section">
      <div class="about-wrap about-result">
        <div>
          <p class="about-eyebrow">Ответственность за результат</p>
          <h2>Что считается первым рабочим запуском</h2>
          <p class="about-intro">
            Через 7 дней клиент получает не презентацию и не пустой шаблон,
            а согласованный первый управленческий контур.
          </p>
        </div>
        <ul>
          {RESULT.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </section>

    <section class="about-cta">
      <div class="about-wrap">
        <h2>Разберём вашу систему управления за 30 минут</h2>
        <p>Покажем, какие данные стоит объединить и что реально запустить первым этапом.</p>
        <button type="button" class="btn btn-on-brand js-open-contact" data-source="about_page">
          Получить аудит
        </button>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .about-page { background: #fff; color: #17181c; }
  .about-wrap { width: min(1120px, calc(100% - 40px)); margin: 0 auto; }
  .about-hero { padding: 28px 0 96px; background: #3f6ee8; color: #fff; }
  .about-back { display: inline-block; color: rgba(255,255,255,.82); text-decoration: none; font-size: 14px; margin-bottom: 76px; }
  .about-eyebrow { margin-bottom: 18px; color: #3f6ee8; font-size: 12px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
  .about-hero .about-eyebrow { color: rgba(255,255,255,.72); }
  .about-hero h1 { max-width: 940px; font-size: clamp(42px, 6vw, 76px); line-height: .98; letter-spacing: -.045em; }
  .about-lead { max-width: 760px; margin-top: 34px; font-size: 20px; line-height: 1.6; color: rgba(255,255,255,.88); }
  .about-section { padding: 96px 0; }
  .about-section--muted { background: #edeef2; }
  .about-section--dark { background: #0a0a0a; color: #fff; }
  .about-section h2, .about-cta h2 { max-width: 780px; font-size: clamp(32px, 4vw, 52px); line-height: 1.08; letter-spacing: -.03em; }
  .about-intro { max-width: 720px; margin-top: 20px; font-size: 17px; line-height: 1.65; color: #60626b; }
  .about-section--dark .about-intro { color: #a3a3a3; }
  .about-story, .about-result { display: grid; grid-template-columns: .85fr 1.15fr; gap: 72px; align-items: start; }
  .about-copy h3 { font-size: 28px; margin-bottom: 6px; }
  .about-role { color: #3f6ee8 !important; font-weight: 700; }
  .about-copy p { margin-bottom: 18px; font-size: 17px; line-height: 1.7; color: #60626b; }
  .about-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin-top: 42px; }
  .about-grid--three { grid-template-columns: repeat(3, 1fr); }
  .about-card { padding: 28px; background: #fff; clip-path: polygon(0 0,100% 0,100% calc(100% - 12px),calc(100% - 12px) 100%,0 100%); }
  .about-section--dark .about-card { background: #181818; }
  .about-card > span { display: block; margin-bottom: 28px; color: #3f6ee8; font-size: 13px; font-weight: 800; }
  .about-card h3 { margin-bottom: 12px; font-size: 19px; line-height: 1.3; }
  .about-card p { font-size: 14px; line-height: 1.65; color: #60626b; }
  .about-section--dark .about-card p { color: #a3a3a3; }
  .about-note { margin-top: 24px; max-width: 820px; color: #a3a3a3; font-size: 13px; line-height: 1.6; }
  .about-result ul { list-style: none; padding: 0; margin: 0; }
  .about-result li { position: relative; padding: 18px 20px 18px 48px; border-top: 1px solid #d8d9df; font-size: 15px; line-height: 1.55; }
  .about-result li::before { content: '✓'; position: absolute; left: 18px; color: #3f6ee8; font-weight: 900; }
  .about-cta { padding: 80px 0; background: #3f6ee8; color: #fff; }
  .about-cta p { margin: 18px 0 28px; max-width: 680px; color: rgba(255,255,255,.82); font-size: 17px; line-height: 1.6; }
  @media (max-width: 900px) {
    .about-story, .about-result { grid-template-columns: 1fr; gap: 34px; }
    .about-grid, .about-grid--three { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 600px) {
    .about-wrap { width: min(100% - 32px, 1120px); }
    .about-hero { padding-bottom: 64px; }
    .about-back { margin-bottom: 52px; }
    .about-hero h1 { font-size: 42px; }
    .about-lead { font-size: 17px; }
    .about-section { padding: 64px 0; }
    .about-grid, .about-grid--three { grid-template-columns: 1fr; }
  }
</style>
