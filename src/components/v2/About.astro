---
// Блок «О нас» — перед FAQ.
// ⚠ Контента от клиента пока нет: собрано из позиционирования, кейсов
// и реквизитов. История и лица основателей — добавить, когда пришлют.
const FACTS = [
  ['4', 'отраслевых кейса на сайте — образование, строительство, продажи, телеком'],
  ['7 дней', 'от старта до дашборда собственника с реальными данными'],
  ['30 минут', 'диагностика без презентаций и продаж'],
  ['100%', 'работаем по договору: ИП, реквизиты и политика ПДн — в открытом доступе'],
];

const PRINCIPLES = [
  [
    'Управление на цифрах, а не на ощущениях',
    'Мы не продаём «ещё одну CRM». Мы собираем данные из систем, которые у вас уже есть, в одну картину, по которой можно принимать решения.',
  ],
  [
    'Не ломаем то, что работает',
    'Внедряем без остановки процессов и без переучивания команды с нуля. Платформа подстраивается под вашу модель, а не наоборот.',
  ],
  [
    'Говорим честно, если не подходим',
    'Если задача решается проще и дешевле без платформы — скажем об этом на диагностике и подскажем более простой вариант.',
  ],
];
---
<section id="about" class="bg-brand section ab-sect">
  <div class="container">
    <div class="eyebrow">
      <div class="eyebrow-line"></div>
      <span class="eyebrow-text">О нас</span>
    </div>

    <div class="ab-head">
      <h2 class="ab-h2">Кто стоит за&nbsp;SHVEC</h2>
      <p class="ab-lead">
        SHVEC&nbsp;— агентство управленческих решений. Мы&nbsp;собираем бизнес
        в&nbsp;одну систему, где собственник видит реальную картину каждый день:
        сайт, CRM, финансы, задачи и&nbsp;отчётность в&nbsp;единой платформе.
        Работаем с&nbsp;бизнесом, который перерос таблицы и&nbsp;разрозненные
        сервисы, но&nbsp;ещё не&nbsp;имеет полноценной управленческой системы.
      </p>
    </div>

    <div class="ab-facts">
      {FACTS.map(([v, l]) => (
        <div class="ab-fact">
          <span class="ab-fact-v">{v}</span>
          <span class="ab-fact-l">{l}</span>
        </div>
      ))}
    </div>

    <div class="ab-princ">
      {PRINCIPLES.map(([t, d], i) => (
        <div class="ab-pr">
          <span class="ab-pr-num">{String(i + 1).padStart(2, '0')}</span>
          <div class="ab-pr-t">{t}</div>
          <p class="ab-pr-d">{d}</p>
        </div>
      ))}
    </div>

    <div class="ab-legal">
      <span class="ab-legal-lab">Реквизиты</span>
      <span class="ab-legal-txt">
        ИП&nbsp;Будаева Юлия Юрьевна · ИНН&nbsp;333412284650 · ОГРНИП&nbsp;326774600414959 ·
        <a href="mailto:admin@shvec.tech">admin@shvec.tech</a>
      </span>
    </div>
  </div>
</section>

<style>
  .ab-head { max-width: 780px; margin-bottom: 36px; }
  .ab-h2 {
    font-size: 38px;
    font-weight: 800;
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: #fff;
    margin-bottom: 16px;
  }
  .ab-lead {
    font-size: 16px;
    line-height: 1.65;
    color: rgba(255,255,255,0.85);
  }

  .ab-facts {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    margin-bottom: 10px;
  }
  .ab-fact {
    background: rgba(255,255,255,0.12);
    clip-path: polygon(0 0,100% 0,100% calc(100% - 10px),calc(100% - 10px) 100%,0 100%);
    padding: 22px 22px 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .ab-fact-v {
    font-size: 30px;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.02em;
    color: #fff;
    font-variant-numeric: tabular-nums;
  }
  .ab-fact-l {
    font-size: 13px;
    line-height: 1.5;
    color: rgba(255,255,255,0.8);
  }

  .ab-princ {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    margin-bottom: 10px;
  }
  .ab-pr {
    background: #fff;
    clip-path: polygon(0 0,100% 0,100% calc(100% - 12px),calc(100% - 12px) 100%,0 100%);
    padding: 26px 26px 28px;
  }
  .ab-pr-num {
    display: block;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.05em;
    color: var(--brand);
    font-variant-numeric: tabular-nums;
    margin-bottom: 12px;
  }
  .ab-pr-t {
    font-size: 18px;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--l-text);
    margin-bottom: 10px;
  }
  .ab-pr-d {
    font-size: 14px;
    line-height: 1.6;
    color: var(--l-text-sec);
  }

  .ab-legal {
    display: flex;
    align-items: baseline;
    gap: 16px;
    flex-wrap: wrap;
    padding-top: 18px;
    border-top: 1px solid rgba(255,255,255,0.25);
  }
  .ab-legal-lab {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.7);
  }
  .ab-legal-txt {
    font-size: 13px;
    line-height: 1.6;
    color: rgba(255,255,255,0.85);
  }
  .ab-legal-txt a { color: #fff; text-decoration: none; }

  @media (max-width: 768px) {
    .ab-h2 { font-size: 26px; }
    .ab-head { margin-bottom: 24px; }
    .ab-lead { font-size: 15px; }
    .ab-facts { grid-template-columns: 1fr 1fr; gap: 8px; }
    .ab-fact { padding: 16px 16px 18px; gap: 8px; }
    .ab-fact-v { font-size: 24px; }
    .ab-fact-l { font-size: 12px; }
    .ab-princ { grid-template-columns: 1fr; gap: 8px; margin-top: 8px; }
    .ab-pr { padding: 20px 18px 22px; }
    .ab-pr-t { font-size: 16px; }
    .ab-pr-d { font-size: 13.5px; }
  }
</style>
