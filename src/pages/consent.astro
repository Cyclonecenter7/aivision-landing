---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Footer from '@/components/v2/Footer.astro';
import { SEO, seoUrl } from '@/lib/seo';

const seo = SEO.consent;
const operator = [
  ['ФИО', 'Будаева Юлия Юрьевна'],
  ['Статус', 'Индивидуальный предприниматель'],
  ['ИНН', '333412284650'],
  ['ОГРНИП', '326774600414959'],
  ['Email', 'admin@aivisionpro.ru'],
  ['Телефон', '+7 985 664 8001'],
  ['Бренд', 'AIVISION'],
];
---
<BaseLayout title={seo.title} description={seo.description} canonical={seoUrl(seo)} ogTitle={seo.ogTitle} ogDescription={seo.ogDescription} ogImage={seo.ogImage} twitterImage={seo.twitterImage} robots={seo.robots}>
  <div style="background:#fff;min-height:100vh">
    <header style="padding:24px 48px;border-bottom:1px solid #E8E8E8">
      <a
        href="/"
        style="display:inline-flex;align-items:center;gap:10px;color:#0A0A0A;text-decoration:none;font-size:14px;font-weight:700;letter-spacing:0.15em"
      >
        <svg width="22" height="22" viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg">
          <path d="M0 0 L32 0 L32 26 L26 32 L0 32 Z" fill="#0A0A0A" />
        </svg>
        AIVISION
      </a>
    </header>
    <main style="max-width:720px;margin:0 auto;padding:96px 24px 64px;font-family:Inter,sans-serif">
      <div class="flex items-center gap-3 mb-5">
        <div class="w-6 h-px bg-blue"></div>
        <span class="text-blue text-xs font-medium uppercase tracking-widest">Правовая информация</span>
      </div>

      <h1 style="font-size:28px;font-weight:700;color:#0A0A0A;margin-bottom:8px">
        Согласие на обработку персональных данных
      </h1>
      <p style="font-size:13px;color:#888;margin-bottom:32px">Редакция от 29 апреля 2026 г.</p>

      <div style="background:#F8F9FC;padding:24px;margin-bottom:32px">
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px 24px">
          {operator.map(([label, value]) => (
            <div>
              <div style="font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:0.12em;color:#888;margin-bottom:4px">{label}</div>
              <div style="font-size:13px;color:#0A0A0A;font-weight:500">{value}</div>
            </div>
          ))}
        </div>
      </div>

      <section class="legal-section">
        <h2><span class="legal-num">01</span>Субъект персональных данных</h2>
        <p>Физическое лицо (далее — «Пользователь»), осуществляющее заполнение формы на Сайте Оператора и проставляющее отметку (чекбокс) о согласии с настоящим документом.</p>
      </section>

      <section class="legal-section">
        <h2><span class="legal-num">02</span>Перечень персональных данных</h2>
        <p><strong>Данные, предоставляемые добровольно:</strong> имя; номер контактного телефона; Telegram-аккаунт.</p>
        <p><strong>Данные, собираемые автоматически:</strong> IP-адрес; тип и версия ОС; тип и версия браузера; тип устройства и разрешение экрана; источник перехода (реферер); язык ОС и браузера; сведения о посещённых страницах; cookie-идентификаторы; данные собственной системы веб-аналитики Оператора.</p>
      </section>

      <section class="legal-section">
        <h2><span class="legal-num">03</span>Цели обработки</h2>
        <p>Обработка обращений и предоставление консультаций. Заключение и исполнение договоров возмездного оказания услуг. Аналитика, обеспечение функционирования и безопасности Сайта.</p>
      </section>

      <section class="legal-section">
        <h2><span class="legal-num">04</span>Правовые основания обработки</h2>
        <p>Согласие субъекта ПДн — п. 1 ч. 1 ст. 6 152-ФЗ. Исполнение договора — п. 5 ч. 1 ст. 6 152-ФЗ. Законные интересы Оператора — п. 7 ч. 1 ст. 6 152-ФЗ.</p>
      </section>

      <section class="legal-section">
        <h2><span class="legal-num">05</span>Перечень действий с персональными данными</h2>
        <p>Сбор, запись, систематизация, накопление, хранение, уточнение (обновление, изменение), извлечение, использование, передача (предоставление, доступ), обезличивание, блокирование, удаление, уничтожение — как с использованием средств автоматизации, так и без таковых.</p>
      </section>

      <section class="legal-section">
        <h2><span class="legal-num">06</span>Передача персональных данных</h2>
        <p>Могут быть переданы обработчикам на основании договоров (ч. 3 ст. 6 152-ФЗ). Актуальный перечень обработчиков (в т.ч. сервис веб-аналитики и хостинг-провайдер) приведён в <a href="/privacy-policy" style="color:#3F6EE8">Политике обработки ПДн</a>.</p>
        <p>Государственным органам — в случаях, предусмотренных законодательством РФ.</p>
      </section>

      <section class="legal-section">
        <h2><span class="legal-num">07</span>Хранение персональных данных</h2>
        <p>На территории Российской Федерации (ч. 5 ст. 18 152-ФЗ). Срок — не более 5 лет с момента последнего взаимодействия, если иное не предусмотрено договором или законодательством.</p>
      </section>

      <section class="legal-section">
        <h2><span class="legal-num">08</span>Срок действия согласия</h2>
        <p>5 лет с момента предоставления либо до отзыва. Если обработка необходима для исполнения договора — продолжается до полного исполнения обязательств.</p>
      </section>

      <section class="legal-section">
        <h2><span class="legal-num">09</span>Порядок отзыва согласия</h2>
        <p>По электронной почте: <a href="mailto:admin@aivisionpro.ru" style="color:#3F6EE8">admin@aivisionpro.ru</a> (тема: «Отзыв согласия на обработку ПДн»). Почтовым отправлением по адресу Оператора. Оператор прекращает обработку и уничтожает ПДн в течение 30 дней.</p>
      </section>

      <section class="legal-section">
        <h2><span class="legal-num">10</span>Способ предоставления согласия</h2>
        <p>Проставление отметки (чекбокса) в поле: «Я ознакомлен(-а) и согласен(-а) с Согласием на обработку персональных данных и Политикой обработки персональных данных» на странице оформления заявки на Сайте. Является конклюдентным действием (ч. 1 ст. 9 152-ФЗ).</p>
      </section>
    </main>
    <Footer />
  </div>
</BaseLayout>

<style is:global>
  .legal-section { margin-top: 32px; padding-top: 32px; border-top: 1px solid #E8E8E8; }
  .legal-section h2 { font-size: 15px; font-weight: 700; color: #0A0A0A; margin: 0 0 12px; }
  .legal-section p { font-size: 13px; line-height: 1.75; color: #444; margin-bottom: 10px; }
  .legal-num { color: #3F6EE8; font-weight: 700; margin-right: 8px; }
</style>
