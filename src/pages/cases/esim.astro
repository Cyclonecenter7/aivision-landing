<script>
  // Mobile carousel
  (function () {
    const track = document.getElementById('mtrack');
    const dotsEl = document.getElementById('mdots');
    const ctr = document.getElementById('mctr');
    const prev = document.getElementById('mprev') as HTMLButtonElement | null;
    const next = document.getElementById('mnext') as HTMLButtonElement | null;
    if (!track || !dotsEl || !ctr || !prev || !next) return;
    const total = track.children.length;
    let cur = 0;

    for (let i = 0; i < total; i++) {
      const d = document.createElement('div');
      d.className = 'car-dot' + (i === 0 ? ' on' : '');
      d.addEventListener('click', () => go(i));
      dotsEl.appendChild(d);
    }

    function go(n: number) {
      cur = Math.max(0, Math.min(total - 1, n));
      (track as HTMLElement).style.transform = `translateX(-${cur * 100}%)`;
      dotsEl!.querySelectorAll('.car-dot').forEach((d, i) => d.classList.toggle('on', i === cur));
      ctr!.textContent = `${cur + 1} / ${total}`;
      prev!.disabled = cur === 0;
      next!.disabled = cur === total - 1;
    }

    prev.addEventListener('click', () => go(cur - 1));
    next.addEventListener('click', () => go(cur + 1));

    let sx = 0;
    track.addEventListener('touchstart', (e) => { sx = e.touches[0].clientX; }, { passive: true });
    track.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - sx;
      if (Math.abs(dx) > 40) go(cur + (dx < 0 ? 1 : -1));
    }, { passive: true });
  })();
</script>
