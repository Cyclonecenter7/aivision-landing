---
// Cookie-баннер управляет собственной поведенческой аналитикой.
// Яндекс.Метрика запускается сразу для рекламной атрибуции.
// Баннер показывается во всех окружениях (чтобы согласие можно было проверить
// на dev), но Я.Метрика грузится только в prod.
const YM_ID = 109677313;
const isProd = import.meta.env.PUBLIC_ENV === 'production';
---
<div id="cookie-banner" class="ck-banner" hidden>
  <p class="ck-text">
    Сайт использует собственную аналитику и аналитические cookie Яндекс.Метрики.
    Нажимая «Принять»,
    вы соглашаетесь на&nbsp;их обработку согласно
    <a href="/privacy-policy"> Политике обработки ПДн</a>.
  </p>
  <div class="ck-actions">
    <button type="button" id="cookie-reject" class="ck-btn ck-reject">Отклонить</button>
    <button type="button" id="cookie-accept" class="ck-btn ck-accept">Принять</button>
  </div>
</div>

    <script is:inline define:vars={{ YM_ID, isProd }}>
      (function () {
        var KEY = 'shvec_cookie_consent';
        function loadYM() {
          if (!isProd) return;
          if (window.__ym_loaded) return;
          window.__ym_loaded = true;
          (function (m, e, t, r, i, k, a) {
            m[i] = m[i] || function () { (m[i].a = m[i].a || []).push(arguments); };
            m[i].l = 1 * new Date();
            for (var j = 0; j < document.scripts.length; j++) { if (document.scripts[j].src === r) { return; } }
            k = e.createElement(t); a = e.getElementsByTagName(t)[0]; k.async = 1; k.src = r; a.parentNode.insertBefore(k, a);
          })(window, document, 'script', 'https://mc.yandex.ru/metrika/tag.js?id=' + YM_ID, 'ym');
          ym(YM_ID, 'init', {
            ssr: true,
            webvisor: true,
            clickmap: true,
            ecommerce: 'dataLayer',
            accurateTrackBounce: true,
            trackLinks: true,
            referrer: document.referrer,
            url: location.href,
          });
        }
        function loadAnalytics() {
          loadYM();
        }
        // Яндекс.Метрика считает визит сразу; cookie-баннер и его UI не меняем.
        loadYM();
        var consent = null;
        try { consent = localStorage.getItem(KEY); } catch (e) {}
        var banner = document.getElementById('cookie-banner');
        if (consent === 'accepted') {
          loadAnalytics();
        } else if (consent !== 'rejected' && banner) {
          banner.hidden = false;
        }
        function decide(val) {
          try { localStorage.setItem(KEY, val); } catch (e) {}
          if (banner) banner.hidden = true;
          if (val === 'accepted') {
            loadAnalytics();
            window.dispatchEvent(new CustomEvent('shvec:analytics-consent'));
          } else {
            try { localStorage.removeItem('shvec_visitor_id'); } catch (e) {}
            try {
              sessionStorage.removeItem('shvec_session_id');
              sessionStorage.removeItem('shvec_session_context');
              sessionStorage.removeItem('shvec_session_tracked');
            } catch (e) {}
          }
        }
        var acc = document.getElementById('cookie-accept');
        var rej = document.getElementById('cookie-reject');
        if (acc) acc.addEventListener('click', function () { decide('accepted'); });
        if (rej) rej.addEventListener('click', function () { decide('rejected'); });
      })();
    </script>

<style>
  .ck-banner {
    position: fixed;
    left: 20px;
    bottom: 20px;
    z-index: 200;
    max-width: 380px;
    background: #181818;
    clip-path: polygon(0 0,100% 0,100% calc(100% - 12px),calc(100% - 12px) 100%,0 100%);
    padding: 20px 22px;
    box-shadow: 0 20px 50px -10px rgba(0,0,0,0.5);
  }
  .ck-banner[hidden] { display: none; }
  .ck-text {
    font-size: 12.5px;
    line-height: 1.6;
    color: #A3A3A3;
    margin-bottom: 16px;
  }
  .ck-text a { color: #3F6EE8; text-decoration: none; }
  .ck-actions { display: flex; gap: 8px; }
  .ck-btn {
    flex: 1;
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.04em;
    padding: 11px 14px;
    border: none;
    cursor: pointer;
    clip-path: polygon(0 0,100% 0,100% calc(100% - 5px),calc(100% - 5px) 100%,0 100%);
    transition: background 0.15s;
  }
  .ck-reject { background: #2A2A2A; color: #E4E4E7; }
  .ck-reject:hover { background: #333333; }
  .ck-accept { background: #3F6EE8; color: #fff; }
  .ck-accept:hover { background: #5A85F0; }

  /* Выше sticky-CTA — на мобилке они делят низ экрана */
  @media (max-width: 768px) {
    .ck-banner { left: 12px; right: 12px; bottom: 72px; max-width: none; }
  }
</style>
