---
// Блок 3 · Проблемы собственника, понятные независимо от наличия CRM.
const SIGNS = [
  'Данные о продажах, расходах и прибыли приходится собирать из нескольких систем.',
  'Цифры в CRM, таблицах и отчётах сотрудников не совпадают.',
  'Чтобы понять положение дел, собственнику приходится лично опрашивать команду.',
  'Реальная маржа по проектам и направлениям становится известна слишком поздно.',
  'Важные процессы зависят от отдельных сотрудников и их личных файлов.',
  'Причины отклонений приходится искать вручную уже после того, как бизнес потерял деньги.',
];
---
<section id="diagnostic" class="bg-light section dg-sect">
  <span id="business-losses" class="anchor-target" aria-hidden="true"></span>
  <div class="container">
    <div class="eyebrow">
      <div class="eyebrow-line"></div>
      <span class="eyebrow-text">Узнаёте себя?</span>
    </div>

    <div class="dg-head">
      <h2 class="dg-h2">
        Где бизнес теряет <em>деньги и управляемость</em>
      </h2>
      <p class="dg-lead">
        6&nbsp;признаков того, что собственник получает картину бизнеса
        слишком поздно или собирает её вручную.
      </p>
    </div>

    <div class="dg-grid">
      {SIGNS.map((text, i) => (
        <div class="dg-item">
          <div class="dg-box">
            <span class="dg-num">{String(i + 1).padStart(2, '0')}</span>
            <svg class="dg-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="20 6 9 17 4 12" />
            </svg>
          </div>
          <p class="dg-text">{text}</p>
        </div>
      ))}
    </div>

    <div class="dg-note">
      <div class="dg-note-body">
        <p class="dg-note-p">
          Если для вас актуальны хотя&nbsp;бы <strong>2&nbsp;пункта</strong> из&nbsp;списка&nbsp;—
          это повод задуматься об&nbsp;изменениях. Проблема не&nbsp;всегда в&nbsp;команде
          или выборе CRM: возможно, бизнес перерос привычные инструменты, и&nbsp;ему нужна
          единая система управления под&nbsp;ключ.
        </p>
        <p class="dg-note-p dg-note-p2">
          Начните с&nbsp;бесплатной диагностики: мы&nbsp;покажем, где система
          расходится с&nbsp;реальностью, что можно исправить уже сейчас,
          и&nbsp;составим план построения новой системы без&nbsp;остановки текущих
          процессов.
        </p>
      </div>
      <button
        type="button"
        class="btn btn-on-brand dg-cta js-open-contact"
        data-source="diagnostic"
        data-track="diagnostic_cta"
        data-track-block="diagnostic"
      >
        Получить аудит
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14M12 5l7 7-7 7" />
        </svg>
      </button>
    </div>
  </div>
</section>

<style>
  .dg-sect { background: #EDEEF2; }
  .dg-head { max-width: 760px; margin-bottom: 44px; }
  .dg-h2 {
    font-size: 36px;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--l-text);
    margin-bottom: 16px;
  }
  .dg-h2 em { font-style: normal; color: var(--brand); }
  .dg-lead {
    font-size: 16px;
    line-height: 1.65;
    color: var(--l-text-sec);
  }

  .dg-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-bottom: 40px;
  }
  .dg-item {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    background: var(--l-surface);
    clip-path: polygon(0 0,100% 0,100% calc(100% - 10px),calc(100% - 10px) 100%,0 100%);
    padding: 22px 24px;
    transition: transform 0.16s, background 0.16s;
  }
  .dg-item:hover {
    transform: translateY(-1px);
    background: #FBFCFF;
  }
  .dg-box {
    position: relative;
    flex-shrink: 0;
    width: 34px;
    height: 34px;
    background: #E6E7EC;
    clip-path: polygon(0 0,100% 0,100% calc(100% - 6px),calc(100% - 6px) 100%,0 100%);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .dg-num {
    font-size: 12px;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    color: var(--l-text-mut);
    transition: opacity 0.16s;
  }
  .dg-check {
    position: absolute;
    color: var(--brand);
    opacity: 0;
    transition: opacity 0.16s;
  }
  .dg-item:hover .dg-num { opacity: 0; }
  .dg-item:hover .dg-check { opacity: 1; }
  .dg-text {
    font-size: 15px;
    line-height: 1.55;
    color: var(--l-text);
    font-weight: 500;
    padding-top: 4px;
  }

  .dg-note {
    background: var(--brand);
    color: #fff;
    clip-path: polygon(0 0,100% 0,100% calc(100% - 16px),calc(100% - 16px) 100%,0 100%);
    padding: 40px 44px;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 40px;
    align-items: center;
  }
  .dg-note-body { max-width: 720px; }
  .dg-note-p {
    font-size: 15px;
    line-height: 1.65;
    color: rgba(255,255,255,0.82);
  }
  .dg-note-p strong { color: #fff; font-weight: 700; }
  .dg-note-p2 { margin-top: 14px; color: #fff; }
  .btn.btn-on-brand.dg-cta {
    white-space: nowrap;
    flex-shrink: 0;
  }

  @media (max-width: 768px) {
    .dg-h2 { font-size: 26px; }
    .dg-head { margin-bottom: 24px; }
    .dg-lead { font-size: 15px; }
    .dg-grid { grid-template-columns: 1fr; gap: 6px; margin-bottom: 20px; }
    .dg-item { padding: 13px 15px; gap: 11px; }
    .dg-box { width: 26px; height: 26px; }
    .dg-num { font-size: 11px; }
    .dg-text { font-size: 14px; line-height: 1.45; padding-top: 2px; }
    .dg-note {
      grid-template-columns: 1fr;
      gap: 18px;
      padding: 22px 18px;
    }
    .dg-note-p { font-size: 14px; }
    .btn.btn-on-brand.dg-cta { width: 100%; justify-content: center; }
  }
</style>
