---
const FACTS = [
  ['4', 'отраслевых кейса на сайте — образование, строительство, продажи, телеком'],
  ['7 дней', 'до первого рабочего дашборда собственника'],
  ['30 минут', 'диагностика без презентаций и продаж'],
  ['100%', 'работаем по договору: ИП, реквизиты и политика ПДн — в открытом доступе'],
];

const TRUST = [
  [
    'Люди',
    'За продукт и договор отвечает Юлия Будаева. Над внедрением работают специалисты по процессам, финансам, продукту и разработке.',
  ],
  [
    'Методология',
    'Сначала определяем управленческие вопросы и показатели, затем подключаем только те данные, которые помогают на них отвечать.',
  ],
  [
    'Безопасность данных',
    'Разделяем доступы по ролям, защищаем передачу данных и заранее фиксируем хранение, резервное копирование и выгрузку.',
  ],
  [
    'Ответственность за результат',
    'До старта согласуем, что войдёт в первый дашборд и по каким критериям внедрение считается завершённым.',
  ],
];
---
<section id="about" class="bg-brand section ab-sect">
  <div class="container">
    <div class="eyebrow">
      <div class="eyebrow-line"></div>
      <span class="eyebrow-text">О нас</span>
    </div>

    <div class="ab-head">
      <h2 class="ab-h2">Кто стоит за&nbsp;Швец</h2>
      <p class="ab-lead">
        Когда компания растёт, данные оказываются разбросаны между CRM, таблицами,
        переписками и&nbsp;сотрудниками. Так появился Швец&nbsp;— мы&nbsp;собираем
        разрозненные данные, процессы и&nbsp;решения в&nbsp;единую систему управления,
        чтобы собственник видел бизнес целиком и&nbsp;без слепых зон.
      </p>
    </div>

    <div class="ab-facts">
      {FACTS.map(([v, l]) => (
        <div class="ab-fact">
          <span class="ab-fact-v">{v}</span>
          <span class="ab-fact-l">{l}</span>
        </div>
      ))}
    </div>

    <div class="ab-princ">
      {TRUST.map(([t, d], i) => (
        <div class="ab-pr">
          <span class="ab-pr-num">{String(i + 1).padStart(2, '0')}</span>
          <div class="ab-pr-t">{t}</div>
          <p class="ab-pr-d">{d}</p>
        </div>
      ))}
    </div>

    <a class="ab-more" href="/about/" data-track="about_more" data-track-block="about">
      Подробнее о команде, методологии и безопасности →
    </a>

    <div class="ab-legal">
      <span class="ab-legal-lab">Реквизиты</span>
      <span class="ab-legal-txt">
        ИП&nbsp;Будаева Юлия Юрьевна · ИНН&nbsp;333412284650 · ОГРНИП&nbsp;326774600414959 ·
        <a href="mailto:admin@shvec.tech">admin@shvec.tech</a>
      </span>
    </div>
  </div>
</section>

<style>
  .ab-head { max-width: 780px; margin-bottom: 36px; }
  .ab-h2 {
    font-size: 38px;
    font-weight: 800;
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: #fff;
    margin-bottom: 16px;
  }
  .ab-lead {
    font-size: 16px;
    line-height: 1.65;
    color: rgba(255,255,255,0.85);
  }

  .ab-facts {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    margin-bottom: 10px;
  }
  .ab-fact {
    background: rgba(255,255,255,0.12);
    clip-path: polygon(0 0,100% 0,100% calc(100% - 10px),calc(100% - 10px) 100%,0 100%);
    padding: 22px 22px 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .ab-fact-v {
    font-size: 30px;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.02em;
    color: #fff;
    font-variant-numeric: tabular-nums;
  }
  .ab-fact-l {
    font-size: 13px;
    line-height: 1.5;
    color: rgba(255,255,255,0.8);
  }

  .ab-princ {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    margin-bottom: 10px;
  }
  .ab-pr {
    background: #fff;
    clip-path: polygon(0 0,100% 0,100% calc(100% - 12px),calc(100% - 12px) 100%,0 100%);
    padding: 26px 26px 28px;
  }
  .ab-pr-num {
    display: block;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.05em;
    color: var(--brand);
    font-variant-numeric: tabular-nums;
    margin-bottom: 12px;
  }
  .ab-pr-t {
    font-size: 18px;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--l-text);
    margin-bottom: 10px;
  }
  .ab-pr-d {
    font-size: 14px;
    line-height: 1.6;
    color: var(--l-text-sec);
  }

  .ab-legal {
    display: flex;
    align-items: baseline;
    gap: 16px;
    flex-wrap: wrap;
    padding-top: 18px;
    border-top: 1px solid rgba(255,255,255,0.25);
  }
  .ab-legal-lab {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.7);
  }
  .ab-legal-txt {
    font-size: 13px;
    line-height: 1.6;
    color: rgba(255,255,255,0.85);
  }
  .ab-legal-txt a { color: #fff; text-decoration: none; }
  .ab-more {
    display: inline-block;
    margin: 14px 0 22px;
    color: #fff;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
  }

  @media (max-width: 1024px) {
    .ab-princ { grid-template-columns: 1fr 1fr; }
  }

  @media (max-width: 768px) {
    .ab-h2 { font-size: 26px; }
    .ab-head { margin-bottom: 24px; }
    .ab-lead { font-size: 15px; }
    .ab-facts { grid-template-columns: 1fr 1fr; gap: 8px; }
    .ab-fact { padding: 16px 16px 18px; gap: 8px; }
    .ab-fact-v { font-size: 24px; }
    .ab-fact-l { font-size: 12px; }
    .ab-princ { grid-template-columns: 1fr; gap: 8px; margin-top: 8px; }
    .ab-pr { padding: 20px 18px 22px; }
    .ab-pr-t { font-size: 16px; }
    .ab-pr-d { font-size: 13.5px; }
  }
</style>
