---
// Блок 6 · Цены — открыто. Три ступени: подписка → внедрение → поддержка.
const PLANS = [
  {
    kind: 'Самостоятельный старт',
    price: 'Бесплатно',
    cur: '',
    note: 'регистрация и базовый старт без оплаты',
    tiers: [
      ['Старт — бесплатно', 'Зарегистрируйтесь и начните работу в платформе без оплаты.'],
      ['Подписка — 5 000 ₽ / мес', 'Доступ к платформе с базовыми лимитами по пользователям, данным и интеграциям.'],
      ['Расширенные лимиты', 'Больше пользователей, направлений и объёма данных — оставьте заявку, рассчитаем под ваш масштаб.'],
    ],
    actions: [
      {
        label: 'Зарегистрироваться',
        href: 'https://app.shvec.tech/signup',
        track: 'pricing_signup_cta',
        yandexGoal: 'reg_begin_click_main',
      },
      {
        label: 'Записаться на диагностику',
        modal: true,
        track: 'pricing_subscription_lead_cta',
      },
    ],
  },
  {
    kind: 'Запуск под ключ',
    price: '200 000–350 000',
    cur: '₽',
    note: 'разово за внедрение',
    tiers: [
      ['Аудит процессов', 'Определяем источники данных, управленческие показатели и первый рабочий контур.'],
      ['Настройка системы', 'Подключаем источники, рабочие области, роли и дашборд собственника.'],
      ['Запуск команды', 'Переносим данные, проверяем сценарии и закрепляем правила работы.'],
    ],
  },
  {
    kind: 'Развитие системы',
    price: 'от 25 000',
    cur: '₽ / мес',
    note: 'после запуска',
    tiers: [
      ['Поддержка команды', 'Отвечаем на вопросы и помогаем встроить систему в ежедневную работу.'],
      ['Корректировка процессов', 'Донастраиваем отчёты, роли и правила по фактическому использованию.'],
      ['Новые контуры', 'Добавляем направления, показатели и интеграции по мере роста бизнеса.'],
    ],
  },
];

// Окупаемость — цифрами из кейсов на сайте, а не оценками.
const PAYBACK = [
  ['+18–27%', 'маржинальность ключевых направлений', 'Образование'],
  ['−20%', 'избыточные расходы в первые месяцы', 'Образование'],
  ['1 из 4', 'проектов оказался убыточным — решение приняли по цифрам', 'Строительство'],
  ['2 ч/день', 'менеджера возвращены в продажи из сбора отчётов', 'Продажи'],
  ['0', 'просроченных налоговых оплат — прогноз ДДС на 6–12 месяцев', 'Строительство'],
];
---
<section id="pricing" class="bg-dark section pr-sect">
  <div class="container">
    <div class="eyebrow">
      <div class="eyebrow-line"></div>
      <span class="eyebrow-text">Стоимость</span>
    </div>

    <div class="pr-head">
      <h2 class="pr-h2">Стоимость — <em>открыто</em></h2>
      <p class="pr-lead">
        Выберите самостоятельный старт или запуск под&nbsp;ключ. После внедрения
        систему можно развивать вместе с&nbsp;командой Швец.
        Даже если у&nbsp;вас нет финансового директора, Швец поможет собрать базовую
        управленческую отчётность: продажи, оплаты, расходы, маржу, платежи
        и&nbsp;риски кассового разрыва.
      </p>
    </div>

    <div class="pr-grid">
      {PLANS.map((p) => (
        <div class="pr-card">
          <div class="pr-card-head">
            <span class="pr-kind">{p.kind}</span>
            <div class="pr-price">{p.price}&nbsp;<span class="pr-cur">{p.cur}</span></div>
            <span class="pr-once">{p.note}</span>
          </div>
          <div class="pr-tiers">
            {p.tiers.map(([t, d]) => (
              <div class="pr-tier">
                <div class="pr-tier-t">{t}</div>
                <div class="pr-tier-d">{d}</div>
              </div>
            ))}
          </div>
          {p.actions && (
            <div class="pr-actions">
              {p.actions.map((action) => (
                action.href ? (
                  <a
                    href={action.href}
                    class="btn btn-on-dark pr-cta"
                    data-track={action.track}
                    data-track-block="pricing"
                    data-ym-goal={action.yandexGoal}
                  >
                    {action.label}
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M5 12h14M12 5l7 7-7 7" />
                    </svg>
                  </a>
                ) : (
                  <button
                    type="button"
                    class:list={['btn', 'btn-secondary', 'pr-cta', 'js-open-contact']}
                    data-source="pricing_subscription"
                    data-track={action.track}
                    data-track-block="pricing"
                  >
                    {action.label}
                  </button>
                )
              ))}
            </div>
          )}
        </div>
      ))}
    </div>

    <div class="pr-swipe">Листайте тарифы →</div>

    <div class="pr-bottom">
      <div class="pr-bcol pr-bcol--pay">
        <div class="pr-bcol-h">За счёт чего окупается</div>
        <p class="pr-bcol-p">
          Платформа окупается на&nbsp;том, что бизнес перестаёт терять деньги вслепую:
          видно убыточные направления, зависшие сделки, ручные ошибки и&nbsp;лишнюю
          операционку. Цифры ниже&nbsp;— из&nbsp;наших кейсов.
        </p>
        <ul class="pr-pay">
          {PAYBACK.map(([val, lab, src]) => (
            <li class="pr-pay-row">
              <span class="pr-pay-val">{val}</span>
              <span class="pr-pay-lab">{lab}</span>
              <span class="pr-pay-src">{src}</span>
            </li>
          ))}
        </ul>
        <a href="#cases" class="pr-pay-link" data-track="pricing_to_cases" data-track-block="pricing">
          Смотреть кейсы целиком →
        </a>
      </div>

      <div class="pr-bcol">
        <div class="pr-bcol-h">Запускайте в удобном объёме</div>
        <p class="pr-bcol-p">
          Начните с&nbsp;базового контура, проверьте Швец на&nbsp;реальных процессах
          и&nbsp;постепенно добавляйте направления, интеграции, отчёты, роли и&nbsp;уровни
          контроля. Если нужен полный запуск, сложную систему можно собрать уже
          на&nbsp;первом этапе.
        </p>
      </div>
    </div>

    <p class="pr-fine">
      Финальная сумма, доступы, роли и&nbsp;форматы выгрузки данных фиксируются после
      диагностики в&nbsp;договоре, когда понятны объём данных, количество интеграций
      и&nbsp;первый этап запуска.
    </p>
  </div>
</section>

<style>
  .pr-head { max-width: 720px; margin-bottom: 24px; }
  .pr-h2 {
    font-size: 38px;
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--d-text);
    margin-bottom: 16px;
  }
  .pr-h2 em { font-style: normal; color: var(--brand); }
  .pr-lead {
    font-size: 16px;
    line-height: 1.65;
    color: var(--d-text-sec);
  }

  .pr-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    margin-bottom: 12px;
  }
  .pr-card {
    background: var(--d-surface);
    clip-path: polygon(0 0,100% 0,100% calc(100% - 16px),calc(100% - 16px) 100%,0 100%);
    padding: 30px 28px 10px;
    display: flex;
    flex-direction: column;
  }
  .pr-card .btn-secondary { --btn-secondary-surface: var(--d-surface); }
  .pr-card-head {
    padding-bottom: 22px;
    margin-bottom: 8px;
    border-bottom: 1px solid var(--d-border);
  }
  .pr-kind {
    display: block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--brand);
    margin-bottom: 14px;
  }
  .pr-price {
    font-size: 28px;
    font-weight: 800;
    line-height: 1.1;
    color: var(--d-text);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
    margin-bottom: 8px;
  }
  .pr-cur { font-size: 16px; font-weight: 700; color: var(--d-text-sec); }
  .pr-once { font-size: 13px; color: var(--d-text-mut); }

  .pr-tiers { display: flex; flex-direction: column; }
  .pr-tier {
    padding: 16px 0;
    border-bottom: 1px solid var(--d-border);
  }
  .pr-tier:last-child { border-bottom: none; }
  .pr-tier-t {
    font-size: 15px;
    font-weight: 700;
    color: var(--d-text);
    margin-bottom: 5px;
  }
  .pr-tier-d {
    font-size: 13px;
    line-height: 1.55;
    color: var(--d-text-sec);
  }
  .pr-actions {
    margin-top: auto;
    margin-bottom: 20px;
    display: grid;
    gap: 8px;
  }
  .pr-cta {
    width: 100%;
    justify-content: center;
    margin: 0;
    text-decoration: none;
  }
  .pr-swipe { display: none; }

  .pr-bottom {
    margin-top: 12px;
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    align-items: start;
    gap: 10px;
  }
  .pr-bcol {
    background: var(--d-surface);
    clip-path: polygon(0 0,100% 0,100% calc(100% - 12px),calc(100% - 12px) 100%,0 100%);
    padding: 26px 28px;
  }
  .pr-bcol-h {
    font-size: 15px;
    font-weight: 700;
    color: var(--d-text);
    margin-bottom: 10px;
  }
  .pr-bcol-p {
    font-size: 13px;
    line-height: 1.6;
    color: var(--d-text-sec);
  }

  .pr-pay {
    list-style: none;
    margin: 18px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .pr-pay-row {
    display: grid;
    grid-template-columns: 96px 1fr auto;
    align-items: baseline;
    gap: 14px;
    padding: 11px 0;
    border-top: 1px solid var(--d-border);
  }
  .pr-pay-val {
    font-size: 18px;
    font-weight: 800;
    line-height: 1.2;
    color: var(--brand);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.01em;
  }
  .pr-pay-lab {
    font-size: 13px;
    line-height: 1.5;
    color: var(--d-text-sec);
  }
  .pr-pay-src {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--d-text-mut);
    white-space: nowrap;
  }
  .pr-pay-link {
    display: inline-block;
    margin-top: 16px;
    font-size: 13px;
    font-weight: 600;
    color: var(--brand);
    text-decoration: none;
  }

  .pr-fine {
    margin-top: 24px;
    font-size: 12px;
    line-height: 1.6;
    color: var(--d-text-mut);
    max-width: 900px;
  }

  @media (max-width: 1024px) {
    .pr-grid { grid-template-columns: 1fr 1fr; }
  }

  @media (max-width: 768px) {
    .pr-h2 { font-size: 26px; }
    .pr-head { margin-bottom: 20px; }
    .pr-lead { font-size: 15px; }

    /* Тарифы — горизонтальной прокруткой */
    .pr-grid {
      display: flex;
      align-items: stretch;
      gap: 10px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      margin: 0 -20px;
      padding: 0 20px 4px;
    }
    .pr-grid::-webkit-scrollbar { display: none; }
    .pr-card {
      flex: 0 0 86%;
      scroll-snap-align: start;
      padding: 24px 20px 6px;
    }
    .pr-price { font-size: 26px; }
    .pr-swipe {
      display: block;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--d-text-mut);
      margin: 12px 0;
    }

    .pr-bottom { grid-template-columns: 1fr; }
    .pr-bcol { padding: 22px 20px; }
    .pr-pay-row { grid-template-columns: 84px 1fr; gap: 10px; }
    .pr-pay-src { grid-column: 2; margin-top: 2px; }
    .pr-pay-val { font-size: 17px; }
  }
</style>
