---
// v3 композиция: HERO=Construction (steel) + WB top-right (tan)
// + eSIM (indigo) + Education (crimson) bottom-right.
// Hero иллюстрация — 3 финансовых контура (ОПУ/ДДС/Баланс) из cases-v6.html
---

<svg width="0" height="0" style="position:absolute;overflow:hidden" aria-hidden="true">
  <defs>
    <!-- eco паттерн для WB (фон в карточке) -->
    <symbol id="p-eco" viewBox="0 0 200 140">
      <rect x="0"  y="8"   width="200" height="22" fill="white" opacity=".08"/>
      <polygon points="186,30 200,16 200,30" fill="#0A0A0A" opacity=".9"/>
      <rect x="0"  y="8"   width="3"   height="22" fill="white" opacity=".5"/>
      <text x="8"  y="23" font-family="Inter,sans-serif" font-size="9" font-weight="600" fill="white" opacity=".4">Показы</text>
      <text x="170" y="23" font-family="Inter,sans-serif" font-size="9" fill="white" opacity=".3">100%</text>
      <rect x="0"  y="40"  width="156" height="22" fill="white" opacity=".1"/>
      <polygon points="142,62 156,48 156,62" fill="#0A0A0A" opacity=".9"/>
      <rect x="0"  y="40"  width="3"   height="22" fill="white" opacity=".45"/>
      <text x="8"  y="55" font-family="Inter,sans-serif" font-size="9" font-weight="600" fill="white" opacity=".4">Корзина</text>
      <text x="126" y="55" font-family="Inter,sans-serif" font-size="9" fill="white" opacity=".3">→10%</text>
      <rect x="0"  y="72"  width="104" height="22" fill="white" opacity=".2"/>
      <polygon points="90,94 104,80 104,94" fill="#0A0A0A" opacity=".9"/>
      <rect x="0"  y="72"  width="3"   height="22" fill="white" opacity=".6"/>
      <text x="8"  y="87" font-family="Inter,sans-serif" font-size="9" font-weight="600" fill="white" opacity=".55">Заказы</text>
      <text x="74"  y="87" font-family="Inter,sans-serif" font-size="9" fill="white" opacity=".4">→62%</text>
      <rect x="0"  y="104" width="64"  height="22" fill="white" opacity=".4"/>
      <polygon points="50,126 64,112 64,126" fill="#0A0A0A" opacity=".9"/>
      <rect x="0"  y="104" width="3"   height="22" fill="white" opacity=".9"/>
      <text x="8"  y="119" font-family="Inter,sans-serif" font-size="9" font-weight="700" fill="white" opacity=".8">Выкупы</text>
      <text x="34"  y="119" font-family="Inter,sans-serif" font-size="9" fill="white" opacity=".6">→88%</text>
    </symbol>

    <symbol id="p-esim" viewBox="0 0 220 140">
      <line x1="20" y1="20"  x2="220" y2="20"  stroke="white" stroke-width=".4" opacity=".1"/>
      <line x1="20" y1="55"  x2="220" y2="55"  stroke="white" stroke-width=".4" opacity=".1"/>
      <line x1="20" y1="90"  x2="220" y2="90"  stroke="white" stroke-width=".4" opacity=".1"/>
      <line x1="20" y1="125" x2="220" y2="125" stroke="white" stroke-width=".4" opacity=".15"/>
      <path d="M20,100 C50,95 70,80 90,70 C110,60 130,58 160,45 C180,36 200,30 220,22 L220,125 L20,125 Z" fill="white" opacity=".05"/>
      <path d="M20,115 C50,112 70,105 90,100 C110,95 130,92 160,86 C180,82 200,78 220,73 L220,125 L20,125 Z" fill="white" opacity=".04"/>
      <path d="M20,100 C50,95 70,80 90,70 C110,60 130,58 160,45 C180,36 200,30 220,22" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" opacity=".8"/>
      <path d="M20,115 C50,112 70,105 90,100 C110,95 130,92 160,86 C180,82 200,78 220,73" fill="none" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-dasharray="5 3" opacity=".5"/>
      <circle cx="160" cy="45" r="3.5" fill="white" opacity=".8"/>
      <circle cx="160" cy="86" r="3.5" fill="white" opacity=".5"/>
    </symbol>

    <symbol id="p-edu" viewBox="0 0 200 140">
      <line x1="0" y1="120" x2="200" y2="120" stroke="white" stroke-width=".5" opacity=".15"/>
      <path d="M5,100 C30,98 60,90 90,75 C120,58 150,38 195,22 L195,120 L5,120 Z" fill="white" opacity=".06"/>
      <path d="M5,100 C30,98 60,90 90,75 C120,58 150,38 195,22" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" opacity=".75"/>
      <circle cx="5"   cy="100" r="3" fill="white" opacity=".5"/>
      <circle cx="195" cy="22"  r="4" fill="white" opacity=".9"/>
    </symbol>
  </defs>
</svg>

<section id="cases" class="cs-sect">
  <div class="cs-container">
    <div class="cs-ey"><div class="cs-ey-ln"></div><span class="cs-ey-tx">Кейсы</span></div>

    <div class="cs-head">
      <h2 class="cs-h2">Что мы уже <em>сделали</em></h2>
      <p class="cs-sub">Разные сегменты — единый подход. Управление на цифрах, не на ощущениях.</p>
    </div>

    <div class="cs-grid">

      <!-- HERO: Строительство (steel) -->
      <a class="cs-card cs-hero" href="/cases/construction/" style="--cs-ac:var(--cs-steel)" data-track="case_card_construction" data-track-block="cases">
        <div class="cs-tag cs-t-st">Строительство <span class="cs-tag-sub">· 200+ млн ₽/год · 4 проекта</span></div>
        <div class="cs-ttl">Система в бизнесе с оборотом 200+ млн ₽ и 4 проектами</div>
        <div class="cs-prob">Общий PnL без разбивки — один из проектов тихо съедал ресурс. Развернули полный финансовый контур: ОПУ, ДДС и баланс по каждой единице бизнеса. Учёт перестал быть отчётом — стал инструментом управления.</div>

        <div class="cs-kr">
          <div><div class="cs-kv cs-c-em">4 PnL</div><div class="cs-kl">Раздельно по проектам</div></div>
          <div><div class="cs-kv cs-c-st">3 контура</div><div class="cs-kl">ОПУ · ДДС · Баланс</div></div>
          <div><div class="cs-kv cs-c-em">0</div><div class="cs-kl">Кассовых разрывов</div></div>
        </div>

        <!-- иллюстрация: 3 финансовых контура -->
        <div class="cs-hero-illu">

          <!-- ОПУ блок: каскад -->
          <div class="cs-illu-block">
            <div class="cs-illu-lbl">ОПУ</div>
            <div class="cs-illu-title">Прибыль</div>
            <div class="cs-opu-rows">
              <div class="cs-opu-row">
                <div class="cs-opu-row-bar" style="width:100%"></div>
                <div class="cs-opu-row-lbl">20,5 млн</div>
              </div>
              <div class="cs-opu-row">
                <div class="cs-opu-row-bar" style="width:70%"></div>
                <div class="cs-opu-row-lbl">8,2 млн</div>
              </div>
              <div class="cs-opu-row">
                <div class="cs-opu-row-bar cs-opu-em-soft" style="width:40%"></div>
                <div class="cs-opu-row-lbl">5,4 млн</div>
              </div>
              <div class="cs-opu-row">
                <div class="cs-opu-row-bar cs-opu-em" style="width:28%"></div>
                <div class="cs-opu-row-lbl cs-c-em" style="font-weight:700">4,0 млн</div>
              </div>
            </div>
          </div>

          <!-- ДДС блок: bars + line -->
          <div class="cs-illu-block">
            <div class="cs-illu-lbl">ДДС</div>
            <div class="cs-illu-title">Движение</div>
            <div class="cs-dds-chart">
              <svg width="100%" height="60" viewBox="0 0 140 60" preserveAspectRatio="none" style="display:block">
                <defs>
                  <linearGradient id="cs-ddsG" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#94A3B8" stop-opacity=".35"/>
                    <stop offset="100%" stop-color="#94A3B8" stop-opacity="0"/>
                  </linearGradient>
                </defs>
                <line x1="0" y1="55" x2="140" y2="55" stroke="#2A2A2A" stroke-width="1"/>
                <rect x="4"   y="48" width="10" height="7"  fill="#10B981" opacity=".4" rx="1"/>
                <rect x="22"  y="46" width="10" height="9"  fill="#10B981" opacity=".4" rx="1"/>
                <rect x="40"  y="42" width="10" height="13" fill="#10B981" opacity=".5" rx="1"/>
                <rect x="58"  y="40" width="10" height="15" fill="#10B981" opacity=".5" rx="1"/>
                <rect x="76"  y="36" width="10" height="19" fill="#10B981" opacity=".55" rx="1"/>
                <rect x="94"  y="34" width="10" height="21" fill="#10B981" opacity=".6" rx="1"/>
                <rect x="112" y="30" width="10" height="25" fill="#10B981" opacity=".65" rx="1"/>
                <path d="M5,32 C25,28 45,22 65,18 C85,14 105,12 135,8" fill="none" stroke="#94A3B8" stroke-width="1.8" stroke-linecap="round"/>
                <path d="M5,32 C25,28 45,22 65,18 C85,14 105,12 135,8 L135,55 L5,55 Z" fill="url(#cs-ddsG)"/>
                <path d="M5,40 C25,38 45,34 65,32 C85,30 105,28 135,26" fill="none" stroke="#F43F5E" stroke-width="1.4" stroke-linecap="round" stroke-dasharray="3 2"/>
              </svg>
            </div>
          </div>

          <!-- Баланс блок: сегментный бар -->
          <div class="cs-illu-block">
            <div class="cs-illu-lbl">БАЛАНС</div>
            <div class="cs-illu-title">Структура</div>
            <div class="cs-bal-seg">
              <div style="width:36%;background:#94A3B8;opacity:.75"></div>
              <div style="width:24%;background:#6366F1;opacity:.7"></div>
              <div style="width:22%;background:#10B981;opacity:.7"></div>
              <div style="width:18%;background:#94A3B8;opacity:.7"></div>
            </div>
            <div class="cs-balance-bar">
              <div class="cs-bal-row">
                <div class="cs-bal-dot" style="background:#94A3B8"></div>
                <span>Дебиторка</span>
                <span class="cs-bal-pct">36%</span>
              </div>
              <div class="cs-bal-row">
                <div class="cs-bal-dot" style="background:#6366F1"></div>
                <span>Запасы</span>
                <span class="cs-bal-pct">24%</span>
              </div>
              <div class="cs-bal-row">
                <div class="cs-bal-dot" style="background:#10B981"></div>
                <span>Денежные</span>
                <span class="cs-bal-pct">22%</span>
              </div>
            </div>
          </div>

        </div>

        <span class="cs-cta cs-cta-st">Открыть кейс <span class="cs-cta-a">→</span></span>
      </a>

      <div class="cs-right">

        <!-- WB / E-commerce — продолговатый, tan -->
        <a class="cs-card cs-sm cs-wb" href="/cases/ecommerce/" style="--cs-ac:var(--cs-tan)" data-track="case_card_ecommerce" data-track-block="cases">
          <div class="cs-wb-content">
            <div class="cs-tag cs-t-tn">E-commerce <span class="cs-tag-sub">· WB · 3 бренда</span></div>
            <div class="cs-ttl-m">Продажи на маркетплейсе — управляемый процесс</div>
            <div class="cs-prob-s">2–3 ч/день ручного сбора отчётов. Закупки в Excel, склады вслепую. Автоматизировали через API.</div>
            <div class="cs-kr cs-sm-kr">
              <div><div class="cs-kv-m cs-c-tn">+35%</div><div class="cs-kl">Выручка/кв.</div></div>
              <div><div class="cs-kv-m cs-c-em">−35%</div><div class="cs-kl">Нагрузка</div></div>
            </div>
            <span class="cs-cta cs-cta-tn">Открыть кейс <span class="cs-cta-a">→</span></span>
          </div>
          <svg class="cs-pat cs-pat-wb" width="180" height="120" aria-hidden="true"><use href="#p-eco"/></svg>
        </a>

        <div class="cs-bottom">
          <!-- eSIM — indigo -->
          <a class="cs-card cs-xs" href="/cases/esim/" style="--cs-ac:var(--cs-in)" data-track="case_card_esim" data-track-block="cases">
            <svg class="cs-pat" width="190" height="110" aria-hidden="true"><use href="#p-esim"/></svg>
            <div class="cs-tag cs-t-in">eSIM <span class="cs-tag-sub">· Крипта + СБП</span></div>
            <div class="cs-ttl-s">Два сайта, два партнёра — одна система</div>
            <div class="cs-prob-s">Разные платёжки — данные не сводились.</div>
            <div class="cs-kr cs-sm-kr">
              <div><div class="cs-kv-s cs-c-in">2 сайта</div><div class="cs-kl">В дашборде</div></div>
              <div><div class="cs-kv-s cs-c-st">100%</div><div class="cs-kl">Учтено</div></div>
            </div>
            <span class="cs-cta cs-cta-in">Открыть <span class="cs-cta-a">→</span></span>
          </a>

          <!-- Образование — crimson -->
          <a class="cs-card cs-xs" href="/cases/education/" style="--cs-ac:var(--cs-cr)" data-track="case_card_education" data-track-block="cases">
            <svg class="cs-pat" width="180" height="110" aria-hidden="true"><use href="#p-edu"/></svg>
            <div class="cs-tag cs-t-cr">Образование <span class="cs-tag-sub">· Офлайн + онлайн</span></div>
            <div class="cs-ttl-s">Оборот рос — прибыль падала</div>
            <div class="cs-prob-s">Видел оборот — не видел маржу. Платформа показала где теряется.</div>
            <div class="cs-kr cs-sm-kr">
              <div><div class="cs-kv-s cs-c-em">+18–27%</div><div class="cs-kl">Маржа</div></div>
              <div><div class="cs-kv-s cs-c-cr">−20%</div><div class="cs-kl">Расходы</div></div>
            </div>
            <span class="cs-cta cs-cta-cr">Открыть <span class="cs-cta-a">→</span></span>
          </a>
        </div>

      </div>
    </div>
  </div>
</section>

<style>
  .cs-sect {
    background: #0A0A0A;
    padding: 88px 0 96px;
    --cs-brand: #3F6EE8;
    --cs-em: #10B981;
    --cs-cr: #F43F5E;
    --cs-slate: #94A3B8;
    --cs-in: #6366F1;
    --cs-sun: #FCD34D;
    --cs-tan: #FB923C;
    --cs-steel: #94A3B8;
    --cs-steel-h: #B4C4D7;
    --cs-surf: #181818;
    --cs-surf2: #222222;
    --cs-brd: #2A2A2A;
    --cs-t1: #FFFFFF;
    --cs-t2: #A3A3A3;
    --cs-t3: #555555;
  }
  .cs-container { max-width: 1280px; margin: 0 auto; padding: 0 36px; }
  .cs-ey { display: flex; align-items: center; gap: 10px; margin-bottom: 16px; }
  .cs-ey-ln { width: 24px; height: 2px; background: var(--cs-brand); }
  .cs-ey-tx { font-size: 11px; font-weight: 600; letter-spacing: .16em; text-transform: uppercase; color: var(--cs-t2); }
  .cs-head { margin-bottom: 40px; max-width: 720px; }
  .cs-h2 { font-size: 36px; font-weight: 900; line-height: 1.1; color: var(--cs-t1); margin-bottom: 14px; letter-spacing: -.01em; }
  .cs-h2 em { color: var(--cs-brand); font-style: normal; }
  .cs-sub { font-size: 15px; line-height: 1.7; color: var(--cs-t2); }

  .cs-grid { display: grid; grid-template-columns: 1.1fr 1fr; gap: 8px; align-items: stretch; }
  .cs-right { display: grid; grid-template-rows: 1fr 1fr; gap: 8px; }
  .cs-bottom { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }

  .cs-card {
    --ch: 16px;
    --cs-ac: var(--cs-brand);
    background: var(--cs-surf);
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - var(--ch)), calc(100% - var(--ch)) 100%, 0 100%);
    padding: 24px;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    position: relative;
    overflow: hidden;
    transition: background .18s;
  }
  .cs-card:hover { background: var(--cs-surf2); }
  .cs-card::before {
    content: '';
    position: absolute;
    left: 0; top: 0;
    width: 2px;
    height: 0;
    background: var(--cs-ac);
    transition: height .22s ease;
  }
  .cs-card:hover::before { height: 100%; }
  .cs-card.cs-sm { --ch: 11px; padding: 20px; }
  .cs-card.cs-xs { --ch: 9px; padding: 16px; }

  .cs-pat {
    position: absolute;
    right: 0; bottom: 0;
    pointer-events: none;
    opacity: .07;
    transition: opacity .25s;
  }
  .cs-card:hover .cs-pat { opacity: .13; }

  .cs-tag {
    display: inline-flex;
    align-items: center;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: #fff;
    padding: 3px 9px;
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - 4px), calc(100% - 4px) 100%, 0 100%);
    margin-bottom: 12px;
    align-self: flex-start;
  }
  .cs-tag-sub { font-size: 8px; font-weight: 500; opacity: .65; margin-left: 4px; }
  .cs-t-br { background: var(--cs-brand); }
  .cs-t-st { background: var(--cs-steel); }
  .cs-t-tn { background: var(--cs-tan); color: #1a0f00; }
  .cs-t-em { background: var(--cs-em); }
  .cs-t-in { background: var(--cs-in); }
  .cs-t-cr { background: var(--cs-cr); }
  .cs-t-sl { background: var(--cs-slate); color: #0A0A0A; }

  .cs-ttl    { font-size: 22px; font-weight: 800; line-height: 1.22; color: var(--cs-t1); margin-bottom: 12px; letter-spacing: -.01em; }
  .cs-ttl-m  { font-size: 15px; font-weight: 700; line-height: 1.3;  color: var(--cs-t1); margin-bottom: 8px; }
  .cs-ttl-s  { font-size: 13px; font-weight: 700; line-height: 1.35; color: var(--cs-t1); margin-bottom: 6px; }
  .cs-prob   { font-size: 13px; line-height: 1.65; color: var(--cs-t2); margin-bottom: 14px; }
  .cs-prob-s { font-size: 12px; line-height: 1.6;  color: var(--cs-t2); margin-bottom: 12px; flex-grow: 1; }

  .cs-kr { display: flex; gap: 18px; flex-wrap: wrap; margin-bottom: 14px; font-variant-numeric: tabular-nums; }
  .cs-kr.cs-sm-kr { gap: 12px; margin-bottom: 10px; }
  .cs-kv   { font-size: 22px; font-weight: 900; line-height: 1; font-variant-numeric: tabular-nums; }
  .cs-kv-m { font-size: 17px; font-weight: 900; line-height: 1; font-variant-numeric: tabular-nums; }
  .cs-kv-s { font-size: 14px; font-weight: 900; line-height: 1; font-variant-numeric: tabular-nums; }
  .cs-kl   { font-size: 9px; color: var(--cs-t3); margin-top: 4px; }
  .cs-c-br { color: var(--cs-brand); }
  .cs-c-em { color: var(--cs-em); }
  .cs-c-cr { color: var(--cs-cr); }
  .cs-c-in { color: var(--cs-in); }
  .cs-c-st { color: var(--cs-steel); }
  .cs-c-tn { color: var(--cs-tan); }

  .cs-cta {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: .05em;
    color: var(--cs-brand);
    display: flex;
    align-items: center;
    gap: 4px;
    margin-top: auto;
    transition: color .15s;
  }
  .cs-cta-a { transition: transform .18s; }
  .cs-card:hover .cs-cta .cs-cta-a { transform: translateX(4px); }
  .cs-cta-st { color: var(--cs-steel); }
  .cs-card:hover .cs-cta-st { color: var(--cs-steel-h); }
  .cs-cta-tn { color: var(--cs-tan); }
  .cs-card:hover .cs-cta-tn { color: #FFA866; }
  .cs-cta-in { color: var(--cs-in); }
  .cs-card:hover .cs-cta-in { color: #8B8DF5; }
  .cs-cta-cr { color: var(--cs-cr); }
  .cs-card:hover .cs-cta-cr { color: #FF6B81; }

  /* ─── HERO иллюстрация: 3 финансовых контура ─── */
  .cs-hero-illu {
    margin-top: auto;
    margin-bottom: 18px;
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 8px;
  }
  .cs-illu-block {
    background: var(--cs-surf2);
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - 8px), calc(100% - 8px) 100%, 0 100%);
    padding: 12px;
    min-height: 140px;
    display: flex;
    flex-direction: column;
  }
  .cs-illu-lbl { font-size: 8px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--cs-steel); margin-bottom: 6px; }
  .cs-illu-title { font-size: 11px; font-weight: 700; color: var(--cs-t1); margin-bottom: 8px; }

  .cs-opu-rows { display: flex; flex-direction: column; gap: 4px; margin-top: auto; }
  .cs-opu-row { display: flex; align-items: center; gap: 6px; }
  .cs-opu-row-bar { height: 6px; background: var(--cs-steel); opacity: .7; border-radius: 1px; flex-shrink: 0; }
  .cs-opu-row-bar.cs-opu-em-soft { background: var(--cs-em); opacity: .55; }
  .cs-opu-row-bar.cs-opu-em { background: var(--cs-em); opacity: .95; }
  .cs-opu-row-lbl { font-size: 9px; color: var(--cs-t2); font-variant-numeric: tabular-nums; min-width: 38px; text-align: right; margin-left: auto; }

  .cs-dds-chart { flex: 1; display: flex; align-items: flex-end; margin-top: auto; }

  .cs-bal-seg {
    display: flex;
    height: 10px;
    gap: 1px;
    margin-bottom: 8px;
