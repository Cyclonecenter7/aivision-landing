---
import Navbar from './Navbar.astro';
---
<section class="bg-brand hero">
  <Navbar />

  <div class="hero-grid">
    <div>
      <h1 class="hero-h1">
        Агентство<br />
        управленческих решений
      </h1>

      <p class="hero-sub">
        Даём собственнику видимость, контроль и управляемость
        через собственную платформу. Решения на данных, а не на ощущениях.
        Внедрение от&nbsp;1&nbsp;недели.
      </p>

      <div class="hero-cta-block">
        <div class="hero-cta-row">
          <button
            type="button"
            class="btn btn-on-brand js-open-contact"
            data-source="hero"
            data-track="hero_cta_diagnose"
            data-track-block="hero"
          >
            Начать диагностику
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14M12 5l7 7-7 7" />
            </svg>
          </button>
          <a
            href="#platform"
            class="btn-ghost js-scroll"
            data-track="hero_cta_platform"
            data-track-block="hero"
          >
            Посмотреть платформу →
          </a>
        </div>
        <div class="hero-cta-sub">30 минут на разбор бизнеса · бесплатно</div>
      </div>
    </div>

    <div class="triad-stage">
      <svg class="triad-svg" viewBox="0 0 480 480" xmlns="http://www.w3.org/2000/svg" overflow="visible">
        <path class="layer-outer" d="M 0 0 L 480 0 L 480 410 L 410 480 L 0 480 Z" fill="rgba(255,255,255,0.16)" />
        <path class="layer-mid" d="M 90 90 L 390 90 L 390 345 L 345 390 L 90 390 Z" fill="rgba(255,255,255,0.32)" />
        <path class="layer-core" d="M 170 170 L 310 170 L 310 290 L 290 310 L 170 310 Z" fill="#FFFFFF" />

        <line x1="445" y1="35" x2="480" y2="35" stroke="rgba(255,255,255,0.4)" stroke-width="1" />
        <circle cx="445" cy="35" r="3.5" fill="#fff" />

        <line x1="360" y1="125" x2="480" y2="125" stroke="rgba(255,255,255,0.4)" stroke-width="1" />
        <circle cx="360" cy="125" r="3.5" fill="#fff" />

        <line x1="290" y1="205" x2="480" y2="205" stroke="rgba(255,255,255,0.4)" stroke-width="1" />
        <circle cx="290" cy="205" r="4" fill="#3F6EE8" stroke="#fff" stroke-width="2" />
      </svg>

      <div class="t-label t-label-01">
        <span class="t-label-num">01</span>
        <span class="t-label-name">Видимость</span>
      </div>
      <div class="t-label t-label-02">
        <span class="t-label-num">02</span>
        <span class="t-label-name">Контроль</span>
      </div>
      <div class="t-label t-label-03">
        <span class="t-label-num">03</span>
        <span class="t-label-name">Управляемость</span>
      </div>
    </div>
  </div>
</section>
