---
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="footer-row">
    <div class="footer-left">
      <svg width="16" height="16" viewBox="0 0 32 32">
        <path d="M0 0 L32 0 L32 26 L26 32 L0 32 Z" fill="currentColor" />
      </svg>
      SHVEC
      <span style="opacity:0.5">·</span>
      <a
        href="mailto:admin@shvec.tech"
        style="color:inherit;text-decoration:none;letter-spacing:normal"
        data-track="footer_email"
        data-track-block="footer"
      >
        admin@shvec.tech
      </a>
    </div>
    <div class="footer-links">
      <a
        href="/demo/"
        target="_blank"
        rel="noopener"
        data-track="footer_demo"
        data-track-block="footer"
      >
        Демо платформы
      </a>
      <a
        href="/privacy-policy"
        data-track="footer_privacy"
        data-track-block="footer"
      >
        Политика ПДн
      </a>
      <a
        href="/consent"
        data-track="footer_consent"
        data-track-block="footer"
      >
        Согласие на обработку ПДн
      </a>
    </div>
    <div>© {year} SHVEC</div>
  </div>

  <div class="footer-legal">
    ИП Будаева Юлия Юрьевна · ИНН 333412284650 · ОГРНИП 326774600414959
  </div>
</footer>

<style>
  .footer-legal {
    max-width: 1200px;
    margin: 16px auto 0;
    padding-top: 14px;
    border-top: 1px solid var(--d-border);
    font-size: 11px;
    line-height: 1.6;
    color: var(--d-text-mut);
  }
</style>
