---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SEO, seoUrl } from '@/lib/seo';
import { faqSchema, serviceSchema } from '@/lib/jsonld';
import { FAQ } from '@/data/faq';

// Композиция главной:
// Hero · Чек-лист · Платформа · Как работаем · Диагностика (форма) ·
// Цены · Кейсы · О нас · FAQ · Футер
// Форма диагностики поднята сразу после «Как работаем» — до цен и кейсов.
import Hero from '@/components/v2/Hero.astro';
import Diagnostic from '@/components/v2/Diagnostic.astro';
import WhatYouGet from '@/components/v2/WhatYouGet.astro';
import HowWeWork from '@/components/v2/HowWeWork.astro';
import Pricing from '@/components/v2/Pricing.astro';
import Cases from '@/components/v2/Cases.astro';
import About from '@/components/v2/About.astro';
import Faq from '@/components/v2/Faq.astro';
import FinalCTA from '@/components/v2/FinalCTA.astro';
import StickyCta from '@/components/v2/StickyCta.astro';
import Footer from '@/components/v2/Footer.astro';
import ContactModalIsland from '@/components/islands/ContactModalIsland.jsx';

const seo = SEO.home;
// Структурные данные: FAQPage (из FAQ) + Service с открытыми ценами.
const homeJsonLd = [faqSchema(FAQ), serviceSchema];
---
<BaseLayout
  title={seo.title}
  description={seo.description}
  canonical={seoUrl(seo)}
  ogTitle={seo.ogTitle}
  ogDescription={seo.ogDescription}
  ogImage={seo.ogImage}
  twitterImage={seo.twitterImage}
  robots={seo.robots}
  jsonLd={homeJsonLd}
>
  <Hero />
  <Diagnostic />
  <WhatYouGet />
  <HowWeWork />
  <FinalCTA />
  <Pricing />
  <Cases />
  <About />
  <Faq />
  <Footer />

  <StickyCta />
  <ContactModalIsland client:load />
</BaseLayout>
