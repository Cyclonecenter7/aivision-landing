---
// Блок 5 · Как мы работаем. Сроки и участие клиента.
const DAYS = [
  ['День 1–2', 'Собираем данные из всех источников, уточняем воронки, роли и зоны ответственности.'],
  ['День 3–5', 'Настраиваем платформу под ваши задачи, процессы и правила работы.'],
  ['День 7', 'Открываем доступ к дашборду собственника. Уже на этом этапе клиенты часто находят 1–3 убыточных направления, которые можно оптимизировать.'],
];
const STEPS = [
  {
    num: '01', time: '30 минут', title: 'Диагностика',
    desc: 'За 30 минут разбираем процессы, команду, текущие системы и таблицы. Рассказываем, как AIVISION упростит управление и какие блоки нужно запускать в первую очередь.',
    res: 'вы понимаете, где бизнес теряет управляемость, какие данные и процессы нужно объединить и с чего начать внедрение.',
  },
  {
    num: '02', time: '7 дней', title: 'Внедрение', days: true,
    desc: 'Через 7 дней вы видите реальную картину бизнеса в одном дашборде.',
    res: 'через 7 дней вы видите в одном дашборде актуальную картину по финансам, продажам, команде и процессам и можете быстро находить убыточные направления и точки потерь.',
  },
  {
    num: '03', time: '1 месяц', title: 'Стабилизация',
    desc: 'В течение месяца проверяем, как команда пользуется платформой, настраиваем поля под реальные сценарии, фиксируем правила работы и помогаем перевести контроль процессов из переписок в AIVISION.',
    res: 'вы получаете систему, которой действительно пользуется команда: данные не теряются в таблицах и переписках, а правила работы закреплены.',
  },
  {
    num: '04', time: 'раз в месяц', title: 'Поддержка',
    desc: 'Раз в месяц смотрим, что изменилось в бизнесе, и донастраиваем платформу с учётом ваших отзывов и опыта команды AIVISION в похожих внедрениях.',
    res: 'вы сохраняете актуальную картину бизнеса по мере его роста и изменений, а платформа адаптируется под новые задачи.',
  },
];
---
<section id="how" class="bg-light section hww-sect">
  <div class="container">
    <div class="eyebrow">
      <div class="eyebrow-line"></div>
      <span class="eyebrow-text">Как работаем</span>
    </div>

    <div class="hww-head">
      <h2 class="hww-h2">Как мы <em>работаем</em></h2>
      <p class="hww-lead">
        Внедряем систему управления бизнесом <strong>под&nbsp;ключ</strong>, без нагрузки
        на&nbsp;вашу команду. Вы тратите 30&nbsp;минут на&nbsp;диагностику,
        2–3&nbsp;часа на&nbsp;внедрение за&nbsp;весь период и&nbsp;по&nbsp;30&nbsp;минут
        на&nbsp;ежемесячные статус-звонки. Подготовка, миграция, настройка и&nbsp;обучение
        полностью на&nbsp;стороне команды AIVISION.
      </p>
    </div>

    <div class="hww-grid">
      {STEPS.map((s) => (
        <div class="hww-step">
          <div class="hww-step-top">
            <span class="hww-step-num">{s.num}</span>
            <span class="hww-step-time">{s.time}</span>
          </div>
          <div class="hww-step-title">{s.title}</div>
          <p class="hww-step-desc">{s.desc}</p>

          {s.days && (
            <div class="hww-days">
              {DAYS.map(([d, t]) => (
                <div class="hww-day">
                  <span class="hww-day-lbl">{d}</span>
                  <span class="hww-day-txt">{t}</span>
                </div>
              ))}
            </div>
          )}

          <div class="hww-step-res">
            <span class="hww-step-res-lab">Результат</span>{s.res}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .hww-sect { background: #EDEEF2; }
  .hww-head { max-width: 760px; margin-bottom: 40px; }
  .hww-h2 {
    font-size: 38px;
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--l-text);
    margin-bottom: 16px;
  }
  .hww-h2 em { font-style: normal; color: var(--brand); }
  .hww-lead {
    font-size: 16px;
    line-height: 1.65;
    color: var(--l-text-sec);
  }
  .hww-lead strong { color: var(--brand); font-weight: 700; }

  .hww-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-bottom: 12px;
  }

  .hww-step {
    background: var(--l-surface);
    clip-path: polygon(0 0,100% 0,100% calc(100% - 12px),calc(100% - 12px) 100%,0 100%);
    padding: 26px 26px 28px;
    display: flex;
    flex-direction: column;
  }

  .hww-step-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
  }
  .hww-step-num {
    font-size: 13px;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    color: var(--brand);
    letter-spacing: 0.05em;
  }
  .hww-step-time {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--l-text-mut);
    background: var(--l-surface-alt);
    padding: 5px 10px 6px;
    clip-path: polygon(0 0,100% 0,100% calc(100% - 4px),calc(100% - 4px) 100%,0 100%);
  }
  .hww-step-title {
    font-size: 20px;
    font-weight: 700;
    color: var(--l-text);
    letter-spacing: -0.01em;
    margin-bottom: 10px;
  }
  .hww-step-desc {
    font-size: 14px;
    line-height: 1.6;
    color: var(--l-text-sec);
  }

  .hww-days {
    margin-top: 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .hww-day {
    display: grid;
    grid-template-columns: 88px 1fr;
    gap: 14px;
    align-items: start;
    background: var(--l-surface-alt);
    clip-path: polygon(0 0,100% 0,100% calc(100% - 6px),calc(100% - 6px) 100%,0 100%);
    padding: 14px 16px;
  }
  .hww-day-lbl {
    font-size: 12px;
    font-weight: 800;
    color: var(--brand);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.01em;
    padding-top: 1px;
  }
  .hww-day-txt {
    font-size: 13px;
    line-height: 1.55;
    color: var(--l-text-sec);
  }

  /* Результат каждого этапа — под контентом, отделён линией */
  .hww-step-res {
    margin-top: auto;
    padding-top: 16px;
    border-top: 1px solid var(--l-border);
    font-size: 13px;
    line-height: 1.55;
    color: var(--l-text-sec);
  }
  .hww-step-desc { margin-bottom: 18px; }
  .hww-step-res-lab {
    color: var(--brand);
    font-weight: 700;
    margin-right: 6px;
  }
  .hww-step-res-lab::after { content: ':'; }

  @media (max-width: 768px) {
    .hww-h2 { font-size: 28px; }
    .hww-grid { grid-template-columns: 1fr; }
    .hww-step { padding: 22px 20px; }
    .hww-day { grid-template-columns: 68px 1fr; gap: 10px; }
  }
</style>
