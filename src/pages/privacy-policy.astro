---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Footer from '@/components/v2/Footer.astro';
import { SEO, seoUrl } from '@/lib/seo';

const seo = SEO.privacy;
const operator = [
  ['ФИО', 'Будаева Юлия Юрьевна'],
  ['Статус', 'Индивидуальный предприниматель'],
  ['ИНН', '333412284650'],
  ['ОГРНИП', '326774600414959'],
  ['Email', 'admin@shvec.tech'],
  ['Телефон', '+7 985 664 8001'],
  ['Бренд', 'Швец'],
];
---
<BaseLayout title={seo.title} description={seo.description} canonical={seoUrl(seo)} ogTitle={seo.ogTitle} ogDescription={seo.ogDescription} ogImage={seo.ogImage} twitterImage={seo.twitterImage} robots={seo.robots}>
  <div style="background:#fff;min-height:100vh">
    <header style="padding:24px 48px;border-bottom:1px solid #E8E8E8">
      <a
        href="/"
        style="display:inline-flex;align-items:center;gap:10px;color:#0A0A0A;text-decoration:none;font-size:14px;font-weight:700;letter-spacing:0.15em"
      >
        <svg width="22" height="22" viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg">
          <path d="M0 0 L32 0 L32 26 L26 32 L0 32 Z" fill="#0A0A0A" />
        </svg>
        Швец
      </a>
    </header>
    <main style="max-width:720px;margin:0 auto;padding:96px 24px 64px;font-family:Inter,sans-serif">
      <div class="flex items-center gap-3 mb-5">
        <div class="w-6 h-px bg-blue"></div>
        <span class="text-blue text-xs font-medium uppercase tracking-widest">Правовая информация</span>
      </div>

      <h1 style="font-size:28px;font-weight:700;color:#0A0A0A;margin-bottom:8px">
        Политика обработки персональных данных
      </h1>
      <p style="font-size:13px;color:#888;margin-bottom:32px">Редакция от 29 июля 2026 г. · версия 2.0</p>

      <div style="background:#F8F9FC;padding:24px;margin-bottom:32px">
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px 24px">
          {operator.map(([label, value]) => (
            <div>
              <div style="font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:0.12em;color:#888;margin-bottom:4px">{label}</div>
              <div style="font-size:13px;color:#0A0A0A;font-weight:500">{value}</div>
            </div>
          ))}
        </div>
      </div>

      <section class="legal-section">
        <h2><span class="legal-num">01</span>Общие положения</h2>
        <p>Настоящая Политика обработки персональных данных (далее — «Политика») разработана в соответствии с Федеральным законом от 27.07.2006 № 152-ФЗ «О персональных данных» (далее — 152-ФЗ) и определяет порядок обработки и защиты персональных данных, осуществляемых Оператором — индивидуальным предпринимателем Будаевой Юлией Юрьевной, действующей под брендом «Швец» (далее — «Оператор»).</p>
        <p>Политика применяется к информации, которую Оператор получает о посетителях и пользователях сайта https://shvec.tech, приложения и личного кабинета https://app.shvec.tech, а также связанных с ними интерфейсов Оператора (совместно — «Сервисы»).</p>
        <p>Оператор ставит своей важнейшей целью и условием осуществления своей деятельности соблюдение прав и свобод человека и гражданина при обработке его персональных данных, в том числе защиту прав на неприкосновенность частной жизни, личную и семейную тайну.</p>
      </section>

      <section class="legal-section">
        <h2><span class="legal-num">02</span>Основные понятия</h2>
        <p><strong>Персональные данные</strong> — любая информация, относящаяся прямо или косвенно к определённому или определяемому Пользователю Сайта.</p>
        <p><strong>Обработка персональных данных</strong> — любое действие (операция) или совокупность действий, совершаемых с персональными данными, включая сбор, запись, систематизацию, накопление, хранение, уточнение, извлечение, использование, передачу, обезличивание, блокирование, удаление, уничтожение.</p>
        <p><strong>Пользователь</strong> — физическое лицо, посещающее Сервисы, направляющее обращение либо использующее учётную запись.</p>
        <p><strong>Клиент</strong> — юридическое лицо или индивидуальный предприниматель, использующий платформу и определяющий цели обработки данных, загружаемых им в платформу.</p>
        <p><strong>Cookie-файлы</strong> — небольшие текстовые файлы, размещаемые на устройстве Пользователя при посещении Сервисов, которые позволяют идентифицировать браузер и сохранять предпочтения.</p>
      </section>

      <section class="legal-section">
        <h2><span class="legal-num">03</span>Принципы обработки персональных данных</h2>
        <p>Обработка осуществляется на законной и справедливой основе, ограничивается достижением конкретных, заранее определённых и законных целей. Не допускается объединение баз данных с несовместимыми целями обработки. Объём и содержание обрабатываемых ПДн соответствуют заявленным целям. Данные являются точными, достаточными и актуальными. Хранение осуществляется не дольше, чем этого требуют цели обработки (ст. 5 152-ФЗ).</p>
      </section>

      <section class="legal-section">
        <h2><span class="legal-num">04</span>Цели обработки, состав ПДн и правовые основания</h2>
        <p><strong>4.1. Обработка обращений и заключение договоров</strong><br />
        Состав ПДн: имя; номер телефона или Telegram-аккаунт; email, если предоставлен; выбранный диапазон оборота компании; сведения, сообщённые Пользователем в обращении.<br />
        Правовое основание: согласие субъекта (п. 1 ч. 1 ст. 6 152-ФЗ); исполнение договора (п. 5 ч. 1 ст. 6 152-ФЗ).</p>
        <p><strong>4.2. Регистрация, предоставление доступа и безопасность кабинета</strong><br />
        Состав ПДн: email; криптографический хеш пароля; идентификаторы пользователя и рабочей области; роль и статус учётной записи; дата подтверждения email; зашифрованные данные двухфакторной аутентификации и хеши кодов восстановления; идентификаторы и сроки действия сессий; IP-адрес; User-Agent; дата, IP-адрес и версия принятого согласия; сведения о входах и действиях, необходимых для защиты Сервисов.<br />
        Правовое основание: согласие субъекта; заключение и исполнение договора; законные интересы Оператора по обеспечению безопасности при условии соблюдения прав субъекта.</p>
        <p><strong>4.3. Аналитика и обеспечение функционирования Сервисов</strong><br />
        Состав ПДн: IP-адрес; тип и версия ОС и браузера; тип устройства и разрешение экрана; источник перехода (реферер); язык; сведения о посещённых страницах и действиях; cookie-идентификаторы; данные собственной системы веб-аналитики Оператора.<br />
        Правовое основание: для аналитических cookie — согласие Пользователя; для строго необходимых технических данных и защиты Сервисов — законные интересы Оператора при условии соблюдения прав субъекта.</p>
        <p><strong>4.4. Рекламные и информационные рассылки</strong><br />
        Состав ПДн: email; номер телефона.<br />
        Правовое основание: отдельное согласие субъекта (п. 1 ч. 1 ст. 6 152-ФЗ; ч. 1 ст. 18 38-ФЗ «О рекламе»).</p>
        <p><strong>4.5. Данные, размещаемые Клиентом в платформе</strong><br />
        Платформа может содержать данные сотрудников, клиентов и контрагентов Клиента, включая имена, должности, контактные сведения и сведения о деловых операциях. Цели и состав таких данных определяет Клиент. Оператор обрабатывает их по поручению Клиента на основании договора, не использует для собственных несовместимых целей и применяет предусмотренные договором меры защиты. Клиент отвечает за наличие правовых оснований для передачи и обработки таких данных.</p>
      </section>

      <section class="legal-section">
        <h2><span class="legal-num">05</span>Cookie-файлы и системы веб-аналитики</h2>
        <p>Сервисы используют cookie-файлы для обеспечения корректного функционирования, сохранения пользовательской сессии и сбора аналитических данных.</p>
        <p>Категории cookie-файлов:<br />
        — Строго необходимые: обеспечивают базовое функционирование Сайта. Не требуют согласия.<br />
        — Аналитические: используются для анализа посещаемости и поведения на Сайте. Устанавливаются на основании согласия.</p>
        <p>Сайт использует собственную систему веб-аналитики Оператора и сервис Яндекс.Метрика (ООО «ЯНДЕКС»). Яндекс.Метрика загружается только после нажатия Пользователем кнопки «Принять» в cookie-баннере. При отказе аналитические cookie не устанавливаются.</p>
        <p>Пользователь может управлять cookie-файлами через настройки своего браузера.</p>
      </section>

      <section class="legal-section">
        <h2><span class="legal-num">06</span>Условия обработки персональных данных</h2>
        <p>Обработка осуществляется с согласия субъекта ПДн на обработку. Обработка необходима для исполнения договора с субъектом ПДн или заключения договора по его инициативе. Обработка необходима для осуществления прав и законных интересов Оператора или третьих лиц при условии соблюдения прав субъекта ПДн. Обработка необходима для исполнения обязанностей, предусмотренных законодательством РФ.</p>
      </section>

      <section class="legal-section">
        <h2><span class="legal-num">07</span>Передача персональных данных третьим лицам</h2>
        <p>Оператор вправе передать персональные данные обработчикам на основании договоров (ч. 3 ст. 6 152-ФЗ).</p>
        <p>Обработчики и инфраструктурные поставщики, привлекаемые Оператором:<br />
        — ООО «ЯНДЕКС» — сервис веб-аналитики Яндекс.Метрика;<br />
        — Timeweb — размещение Сервисов, баз данных и файлов в инфраструктуре на территории РФ;<br />
        — поставщик электронной почты, указанный в технической конфигурации Оператора, — доставка сервисных сообщений и кодов подтверждения;<br />
        — ООО «Яндекс.Облако» — облачные сервисы и автоматизированная обработка загружаемых Клиентом материалов, если соответствующая функция включена Клиентом.</p>
        <p>Оператор поручает обработку только в объёме, необходимом для оказания соответствующей услуги, и закрепляет требования к конфиденциальности, безопасности, локализации и удалению данных в договоре либо применимых условиях сервиса.</p>
        <p>Передача ПДн государственным органам — в случаях, предусмотренных законодательством РФ.</p>
      </section>

      <section class="legal-section">
        <h2><span class="legal-num">08</span>Хранение и локализация персональных данных</h2>
        <p>При сборе ПДн граждан РФ запись, систематизация, накопление, хранение, уточнение и извлечение осуществляются с использованием баз данных на территории Российской Федерации (ч. 5 ст. 18 152-ФЗ).</p>
        <p>Данные незавершённой регистрации удаляются по истечении срока регистрации. Данные активной учётной записи обрабатываются в период использования Сервисов и действия договора. После удаления аккаунта данные удаляются из активных систем по истечении предусмотренного технического периода, по умолчанию 30 дней, если более длительное хранение не требуется законом или для разрешения спора. Загруженные при онбординге файлы хранятся не более 30 дней. Данные обращения без заключения договора — не более 24 месяцев с момента последнего взаимодействия. Сроки хранения cookie определяются настройками соответствующего сервиса и выбором Пользователя.</p>
      </section>

      <section class="legal-section">
        <h2><span class="legal-num">09</span>Меры по обеспечению безопасности персональных данных</h2>
        <p>Оператор принимает правовые, организационные и технические меры для защиты ПДн (ст. 19 152-ФЗ): назначение ответственного за организацию обработки ПДн; издание внутренних нормативных актов; осуществление внутреннего контроля; оценка вреда субъектам ПДн; применение средств защиты информации.</p>
      </section>

      <section class="legal-section">
        <h2><span class="legal-num">10</span>Права субъекта персональных данных</h2>
        <p>Пользователь имеет право: получать информацию об обработке ПДн (ст. 14); требовать уточнения, блокирования или уничтожения ПДн (ст. 14); отозвать согласие (ч. 2 ст. 9); обжаловать действия Оператора в Роскомнадзор или суд (ст. 17).</p>
        <p>Обращения: <a href="mailto:admin@shvec.tech" style="color:#3F6EE8">admin@shvec.tech</a>. Срок рассмотрения — 10 рабочих дней.</p>
      </section>

      <section class="legal-section">
        <h2><span class="legal-num">11</span>Обязанности Оператора</h2>
        <p>Предоставлять информацию об обработке ПДн по запросу. При отзыве согласия — прекратить обработку в срок, установленный законодательством, если отсутствует иное правовое основание. Публиковать Политику на https://shvec.tech/privacy-policy. При инциденте, повлекшем нарушение прав субъектов ПДн, уведомить Роскомнадзор в установленные законом сроки, включая первичное уведомление в течение 24 часов и результаты внутреннего расследования в течение 72 часов.</p>
      </section>

      <section class="legal-section">
        <h2><span class="legal-num">12</span>Трансграничная передача</h2>
        <p>Оператор не осуществляет трансграничную передачу персональных данных в рамках описанной конфигурации Сервисов. До начала использования сервиса, предполагающего такую передачу, Оператор проводит отдельную оценку и выполняет предусмотренные законом процедуры.</p>
      </section>

      <section class="legal-section">
        <h2><span class="legal-num">13</span>Заключительные положения</h2>
        <p>Политика действует бессрочно до замены новой редакцией. Актуальная версия: https://shvec.tech/privacy-policy. Оператор вправе вносить изменения с уведомлением на Сайте.</p>
        <p>Контакт: <a href="mailto:admin@shvec.tech" style="color:#3F6EE8">admin@shvec.tech</a></p>
      </section>
    </main>
    <Footer />
  </div>
</BaseLayout>

<style is:global>
  .legal-section { margin-top: 32px; padding-top: 32px; border-top: 1px solid #E8E8E8; }
  .legal-section h2 { font-size: 15px; font-weight: 700; color: #0A0A0A; margin: 0 0 12px; }
  .legal-section p { font-size: 13px; line-height: 1.75; color: #444; margin-bottom: 10px; }
  .legal-num { color: #3F6EE8; font-weight: 700; margin-right: 8px; }
</style>
