---
// Блок 4 · Что вы получите. Платформа + кастомизация.
// 2×2: 3 текст-карты (col-major 1 3 / 2 4) + 4-й блок = demo-визуализация.
const CARDS = [
  {
    num: '01',
    ac: 'var(--brand)',
    title: 'Видеть деньги',
    body: 'Маржа, платежи, расходы и риски кассового разрыва — в одном месте и с актуальными данными. Интеграция CRM с сайтом связывает заявки, сделки и оплаты, чтобы вы видели показатели по направлениям, проектам и менеджерам.',
    modules: ['Финансы', 'P&L', 'Платежи', 'Дашборды собственника', 'CRM', 'Интеграции'],
  },
  {
    num: '02',
    ac: 'var(--indigo)',
    title: 'Контролировать команду',
    body: 'Сделки, задачи, переписки и договорённости больше не теряются в личных таблицах и головах сотрудников. Все процессы и следующие шаги видны в системе.',
    modules: ['CRM', 'Задачи', 'Регламенты', 'Воронки', 'Роли', 'Уведомления', 'История', 'Интеграции'],
  },
  {
    num: '03',
    ac: 'var(--emerald)',
    title: 'Управлять ростом',
    body: 'Причины роста или стагнации становятся понятны. Маржа упала на 8%? Не опирайтесь на интуицию: смотрите, что изменилось — выросла стоимость материалов, выросли переменные и постоянные издержки, растянулся цикл сделки или появились лишние ручные операции. Корректируйте процессы на основе фактов.',
    modules: [],
  },
];

// Кастомизация — буллетами вместо сплошного абзаца.
const CUSTOM = [
  'Несколько юрлиц и разных направлений — раздельный учёт и общая картина',
  'Интеграция ваших систем учёта, CRM и сайта',
  'Ручные расчёты и нетиповые правила вашей модели',
  'Роли, права доступа и отчёты под вашу структуру управления',
];
---
<section id="platform" class="bg-dark section wyg-sect">
  <span id="management-system" class="anchor-target" aria-hidden="true"></span>
  <div class="container">
    <div class="eyebrow">
      <div class="eyebrow-line"></div>
      <span class="eyebrow-text">Платформа</span>
    </div>

    <div class="wyg-head">
      <h2 class="wyg-h2">Управленческая система объединяет <em>финансы, CRM и задачи</em></h2>
      <p class="wyg-lead">
        Когда финансовые данные разбросаны по&nbsp;таблицам и&nbsp;системам, бизнес
        теряет деньги раньше, чем это становится заметно. Платформа показывает
        в&nbsp;одной картине выручку, маржу, расходы и&nbsp;риски&nbsp;— чтобы вы
        могли принимать решения вовремя.
      </p>
    </div>

    <div class="wyg-grid">
      {CARDS.map((c) => (
        <div class="wyg-card" style={`--ac:${c.ac}`}>
          <div class="wyg-card-top">
            <span class="wyg-card-num">{c.num}</span>
            <h3 class="wyg-card-title">{c.title}</h3>
          </div>
          <p class="wyg-card-body">{c.body}</p>
          {c.modules.length > 0 && (
            <div class="wyg-mods">
              <span class="wyg-mods-lab">Модули</span>
              <div class="wyg-mods-row">
                {c.modules.map((m) => <span class="wyg-mod">{m}</span>)}
              </div>
            </div>
          )}
        </div>
      ))}

      <!-- 4-й блок · demo-визуализация -->
      <div class="wyg-demo">
        <div class="wyg-demo-bar">
          <span class="wyg-demo-eb">Демо-кабинет</span>
          <span class="wyg-demo-live"><span class="wyg-demo-dot"></span>LIVE</span>
        </div>

        <div class="wyg-kpis">
          <div class="wyg-kpi">
            <span class="wyg-kpi-lab">Маржа</span>
            <span class="wyg-kpi-val" style="color:var(--brand)">1,84 <span class="wyg-kpi-u">млн&nbsp;₽</span></span>
            <span class="wyg-kpi-d" style="color:var(--brand)">+27%</span>
          </div>
          <div class="wyg-kpi">
            <span class="wyg-kpi-lab">Доход</span>
            <span class="wyg-kpi-val" style="color:var(--emerald)">4,2 <span class="wyg-kpi-u">млн&nbsp;₽</span></span>
            <span class="wyg-kpi-d" style="color:var(--emerald)">+14%</span>
          </div>
          <div class="wyg-kpi">
            <span class="wyg-kpi-lab">Расход</span>
            <span class="wyg-kpi-val" style="color:var(--crimson)">2,36 <span class="wyg-kpi-u">млн&nbsp;₽</span></span>
            <span class="wyg-kpi-d" style="color:var(--crimson)">+6%</span>
          </div>
        </div>

        <div class="wyg-chart">
          <svg viewBox="0 0 320 96" preserveAspectRatio="none" width="100%" height="96" aria-hidden="true">
            <defs>
              <linearGradient id="wygArea" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#10B981" stop-opacity="0.22" />
                <stop offset="100%" stop-color="#10B981" stop-opacity="0" />
              </linearGradient>
            </defs>
            <line x1="0" y1="30" x2="320" y2="30" stroke="#222" stroke-width="1" stroke-dasharray="2 4" />
            <line x1="0" y1="62" x2="320" y2="62" stroke="#222" stroke-width="1" stroke-dasharray="2 4" />
            <!-- доход (emerald) + заливка -->
            <path d="M4,70 C50,64 80,52 120,44 C160,36 200,30 260,20 C285,16 305,13 316,11 L316,92 L4,92 Z" fill="url(#wygArea)" />
            <path d="M4,70 C50,64 80,52 120,44 C160,36 200,30 260,20 C285,16 305,13 316,11" fill="none" stroke="#10B981" stroke-width="2.25" stroke-linecap="round" />
            <!-- маржа (brand) -->
            <path d="M4,80 C50,77 80,72 120,68 C160,64 200,58 260,50 C285,47 305,44 316,42" fill="none" stroke="#3F6EE8" stroke-width="2.25" stroke-linecap="round" />
            <!-- расход (crimson, пунктир) -->
            <path d="M4,84 C50,83 80,80 120,78 C160,76 200,74 260,70 C285,68 305,67 316,66" fill="none" stroke="#F43F5E" stroke-width="1.75" stroke-linecap="round" stroke-dasharray="3 3" />
          </svg>
          <span class="wyg-chart-dot" aria-hidden="true"></span>
          <div class="wyg-chart-lg">
            <span><span class="wyg-lg-d" style="background:var(--brand)"></span>Маржа</span>
            <span><span class="wyg-lg-d" style="background:var(--emerald)"></span>Доход</span>
            <span><span class="wyg-lg-d" style="background:var(--crimson)"></span>Расход</span>
          </div>
        </div>

        <a
          class="btn btn-secondary wyg-demo-cta"
          href="/demo/"
          target="_blank"
          rel="noopener"
          data-track="whatyouget_demo"
          data-track-block="platform"
          data-ym-goal="demo_click_main"
        >
          Посмотреть демо
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M12 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>

    <div class="wyg-swipe">Листайте карточки →</div>

    <div class="wyg-cst">
      <div class="wyg-cst-eb">
        <span class="wyg-cst-eb-line"></span>
        Кастомизация
      </div>
      <p class="wyg-cst-text">
        Платформа Швец адаптируется под ваш бизнес, не&nbsp;ломая текущие процессы:
      </p>
      <ul class="wyg-cst-list">
        {CUSTOM.map((item) => (
          <li class="wyg-cst-li">
            <svg class="wyg-cst-ico" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="20 6 9 17 4 12" />
            </svg>
            <span>{item}</span>
          </li>
        ))}
      </ul>
      <p class="wyg-cst-foot">
        Всё настраивается на&nbsp;этапе внедрения&nbsp;—
        <strong>без программистов и&nbsp;без остановки работы компании.</strong>
      </p>
    </div>
  </div>
</section>

<style>
  .wyg-head { max-width: 780px; margin-bottom: 40px; }
  .wyg-h2 {
    font-size: 38px;
    font-weight: 800;
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: var(--d-text);
    margin-bottom: 16px;
  }
  .wyg-h2 em { font-style: normal; color: var(--brand); }
  .wyg-lead {
    font-size: 16px;
    line-height: 1.65;
    color: var(--d-text-sec);
  }

  /* 2×2, col-major: 1 3 / 2 4 */
  .wyg-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: auto auto;
    grid-auto-flow: column;
    gap: 10px;
    margin-bottom: 12px;
  }

  .wyg-card {
    --ac: var(--brand);
    background: var(--d-surface);
    clip-path: polygon(0 0,100% 0,100% calc(100% - 14px),calc(100% - 14px) 100%,0 100%);
    padding: 28px 26px 26px;
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
    transition: background 0.16s;
  }
  .wyg-card::before {
    content: '';
    position: absolute;
    left: 0; top: 0;
    width: 2px; height: 0;
    background: var(--ac);
    transition: height 0.22s ease;
  }
  .wyg-card:hover { background: var(--d-surface-alt); }
  .wyg-card:hover::before { height: 100%; }

  .wyg-card-top {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 14px;
  }
  .wyg-card-num {
    font-size: 13px;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    color: var(--ac);
    letter-spacing: 0.05em;
  }
  .wyg-card-title {
    font-size: 20px;
    font-weight: 700;
    color: var(--d-text);
    letter-spacing: -0.01em;
  }
  .wyg-card-body {
    font-size: 14px;
    line-height: 1.65;
    color: var(--d-text-sec);
    margin-bottom: 20px;
    flex-grow: 1;
  }

  .wyg-mods {
    border-top: 1px solid var(--d-border);
    padding-top: 16px;
    margin-top: auto;
  }
  .wyg-mods-lab {
    display: block;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--d-text-mut);
    margin-bottom: 10px;
  }
  .wyg-mods-row { display: flex; flex-wrap: wrap; gap: 6px; }
  .wyg-mod {
    font-size: 11px;
    font-weight: 600;
    color: var(--d-text-sec);
    background: var(--d-surface-alt);
    padding: 5px 10px 6px;
    clip-path: polygon(0 0,100% 0,100% calc(100% - 4px),calc(100% - 4px) 100%,0 100%);
    white-space: nowrap;
  }

  /* ─── demo-визуализация (4-й блок) ─── */
  .wyg-demo {
    background: var(--d-surface);
    clip-path: polygon(0 0,100% 0,100% calc(100% - 14px),calc(100% - 14px) 100%,0 100%);
    padding: 20px 22px 22px;
    display: flex;
    flex-direction: column;
  }
  .wyg-demo-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 14px;
    margin-bottom: 14px;
    border-bottom: 1px solid var(--d-border);
  }
  .wyg-demo-eb {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brand);
  }
  .wyg-demo-live {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--emerald);
  }
  .wyg-demo-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--emerald); }

  .wyg-kpis { display: grid; grid-template-columns: repeat(3,1fr); gap: 8px; margin-bottom: 16px; }
  .wyg-kpi {
    background: var(--d-surface-alt);
    clip-path: polygon(0 0,100% 0,100% calc(100% - 5px),calc(100% - 5px) 100%,0 100%);
    padding: 10px 12px;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .wyg-kpi-lab { font-size: 9px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--d-text-mut); }
  .wyg-kpi-val { font-size: 17px; font-weight: 800; line-height: 1; font-variant-numeric: tabular-nums; letter-spacing: -0.01em; }
  .wyg-kpi-u { font-size: 11px; font-weight: 700; }
  .wyg-kpi-d { font-size: 10px; font-weight: 700; font-variant-numeric: tabular-nums; }

  .wyg-chart { margin-bottom: 18px; position: relative; }
  .wyg-chart svg { display: block; }
  .wyg-chart-dot {
    position: absolute;
    top: 7px;
    right: 3px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--d-surface);
    box-shadow: 0 0 0 2px var(--emerald);
  }
  .wyg-chart-lg {
    display: flex;
    gap: 16px;
    margin-top: 8px;
    font-size: 10px;
    color: var(--d-text-sec);
  }
  .wyg-chart-lg span { display: inline-flex; align-items: center; gap: 5px; }
  .wyg-lg-d { width: 8px; height: 2px; border-radius: 1px; }

  .wyg-demo-cta { margin-top: auto; width: 100%; justify-content: center; }

  /* ─── кастомизация (без градиента, DS) ─── */
  .wyg-cst {
    margin-top: 12px;
    background: rgba(63,110,232,0.12);
    clip-path: polygon(0 0,100% 0,100% calc(100% - 16px),calc(100% - 16px) 100%,0 100%);
    padding: 30px 34px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .wyg-cst-eb {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--brand);
  }
  .wyg-cst-eb-line { width: 20px; height: 2px; background: var(--brand); }
  .wyg-cst-text {
    font-size: 17px;
    line-height: 1.6;
    color: var(--d-text);
    max-width: 900px;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .wyg-swipe { display: none; }

  .wyg-cst-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px 32px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .wyg-cst-li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 15px;
    line-height: 1.55;
    color: var(--d-text-sec);
  }
  .wyg-cst-ico {
    flex-shrink: 0;
    color: var(--brand);
    margin-top: 3px;
  }
  .wyg-cst-foot {
    font-size: 15px;
    line-height: 1.6;
    color: var(--d-text);
    font-weight: 500;
  }
  .wyg-cst-foot strong { color: var(--brand); font-weight: 700; }

  @media (max-width: 768px) {
    .wyg-h2 { font-size: 26px; }
    .wyg-head { margin-bottom: 24px; }
    .wyg-lead { font-size: 15px; }

    /* Карточки — горизонтальной прокруткой, чтобы блок не растягивался
       на 4 экрана по вертикали. */
    .wyg-grid {
      display: flex;
      grid-auto-flow: unset;
      gap: 10px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      margin: 0 -20px 8px;
      padding: 0 20px 4px;
    }
    .wyg-grid::-webkit-scrollbar { display: none; }
    .wyg-card,
    .wyg-demo {
      flex: 0 0 86%;
      scroll-snap-align: start;
      padding: 22px 20px;
    }
    .wyg-card-body { font-size: 13.5px; margin-bottom: 16px; }

    .wyg-swipe {
      display: block;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--d-text-mut);
      margin-bottom: 12px;
    }

    .wyg-cst { padding: 22px 20px; gap: 12px; }
    .wyg-cst-text { font-size: 15px; }
    .wyg-cst-list { grid-template-columns: 1fr; gap: 9px; }
    .wyg-cst-li { font-size: 14px; }
    .wyg-cst-foot { font-size: 14px; }
  }
</style>
