<script>
  document.querySelectorAll<HTMLButtonElement>('.csp-dm-tab[data-csp-tab]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.dataset.cspTab;
      if (!target) return;
      document.querySelectorAll('.csp-dm-tab[data-csp-tab]').forEach((b) => b.classList.remove('on'));
      document.querySelectorAll('.csp-dm-panel').forEach((p) => p.classList.remove('on'));
      btn.classList.add('on');
      const panel = document.querySelector(`.csp-dm-panel[data-csp-panel="${target}"]`);
      if (panel) panel.classList.add('on');
    });
  });
</script>
